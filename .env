# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=1365ed63a4ef38aed1ba5b78bbce6c5e
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
DATABASE_URL="mysql://root:@127.0.0.1:3306/maternia?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
#DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Gmail – 2 options :
#
# 1) SMTP explicite (sans package supplémentaire) – recommandé :
#    Créer un "mot de passe d'application" : Google Compte → Sécurité → Mots de passe des applications.
#    MAILER_DSN="smtp://VOTRE_EMAIL:GENERATED_APP_PASSWORD@smtp.gmail.com:587?encryption=tls&auth_mode=login"
#
# 2) Format court (nécessite : composer require symfony/google-mailer) :
#    MAILER_DSN="gmail://VOTRE_EMAIL:GENERATED_APP_PASSWORD@default"
#
# Expéditeur (avec Gmail, utiliser la même adresse que le compte)
MAILER_FROM="fedi.bourogaa@gmail.com"
MAILER_DSN="smtp://fedi.bourogaa@gmail.com:jrblrsqrjvpsnvwt@smtp.gmail.com:587?encryption=tls&auth_mode=login"
###< symfony/mailer ###

###> marketplace integrations (demo-friendly) ###
# Twilio SMS (laisser vide pour désactiver SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Supplier feed (URL d'un JSON). Peut pointer vers un endpoint local de démo.
SUPPLIER_FEED_URL=
###< marketplace integrations (demo-friendly) ###

###> livraison : distance + DHL + Aramex ###
# OpenRouteService (distance km) : https://openrouteservice.org/dev/#/signup
OPENROUTE_API_KEY=
# Adresse entrepôt (pour calcul distance), ex: "Tunis, Tunisia"
SHIPPING_WAREHOUSE_ADDRESS="Tunis, Tunisia"

# DHL MyDHL API : https://developer.dhl.com/api-reference/dhl-express-mydhl-api (Basic Auth)
DHL_API_BASE_URL=https://express.api.dhl.com/mydhlapi/test
DHL_ACCOUNT_NUMBER=123456789
DHL_USERNAME=demo-key
DHL_PASSWORD=demo-key

# Aramex (Rate API) : identifiants + URL du service de tarification (fournie par Aramex)
ARAMEX_ENABLED=0
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_RATE_URL=
###< livraison : distance + DHL + Aramex ###
