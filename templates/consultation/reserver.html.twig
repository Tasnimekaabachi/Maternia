@keyframes antennaPulse {
    0%,100% { box-shadow: 0 0 6px #C084FC; transform: scale(1); }
    50% { box-shadow: 0 0 16px #C084FC, 0 0 30px rgba(192,132,252,0.4); transform: scale(1.3); }
}
.robot-body.speaking .robot-antenna-ball {
    animation: antennaSpeaking 0.3s ease-in-out infinite alternate;
}
@keyframes antennaSpeaking {
    from { box-shadow: 0 0 8px #10B981; background: #10B981; }
    to { box-shadow: 0 0 24px #10B981; background: #6EE7B7; }
}

/* Tête */
.robot-head {
    width: 90px; height: 80px;
    background: linear-gradient(145deg, #1e1b4b, #2d1b69);
    border-radius: 16px;
    border: 2px solid rgba(164,93,226,0.6);
    box-shadow: 0 4px 20px rgba(164,93,226,0.3), inset 0 1px 0 rgba(255,255,255,0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    position: relative;
}
.robot-eyes {
    display: flex;
    gap: 16px;
}
.robot-eye {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0f0c29, #1a1040);
    border: 1.5px solid rgba(164,93,226,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
}
.robot-pupil {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #C084FC, #7C3AED);
    box-shadow: 0 0 6px rgba(192,132,252,0.8);
    transition: transform 0.1s;
}
.robot-body.blinking .robot-eye { transform: scaleY(0.1); }

/* Bouche */
.robot-mouth {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 16px;
    padding: 0 4px;
}
.robot-mouth-bar {
    width: 7px;
    border-radius: 3px;
    background: #6EE7B7;
    box-shadow: 0 0 6px rgba(110,231,183,0.6);
    height: 4px;
    transition: height 0.1s ease;
}
.robot-body.speaking .robot-mouth-bar { animation: mouthWave 0.3s ease-in-out infinite alternate; }
.robot-mouth-bar:nth-child(1) { animation-delay: 0s; }
.robot-mouth-bar:nth-child(2) { animation-delay: 0.06s; }
.robot-mouth-bar:nth-child(3) { animation-delay: 0.12s; }
.robot-mouth-bar:nth-child(4) { animation-delay: 0.06s; }
.robot-mouth-bar:nth-child(5) { animation-delay: 0s; }
@keyframes mouthWave {
    from { height: 4px; }
    to { height: var(--h, 14px); }
}

/* Torse */
.robot-torso {
    width: 80px; height: 60px;
    background: linear-gradient(145deg, #1a1040, #2d1b69);
    border-radius: 0 0 14px 14px;
    border: 2px solid rgba(164,93,226,0.5);
    border-top: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}
.robot-light {
    width: 14px; height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.1);
}
.rl1 { background: #10B981; box-shadow: 0 0 8px #10B981; animation: lightBlink 2s 0s infinite; }
.rl2 { background: #A45DE2; box-shadow: 0 0 8px #A45DE2; animation: lightBlink 2s 0.7s infinite; }
.rl3 { background: #F59E0B; box-shadow: 0 0 8px #F59E0B; animation: lightBlink 2s 1.4s infinite; }
@keyframes lightBlink {
    0%,100% { opacity: 1; } 50% { opacity: 0.3; }
}
.robot-body.speaking .rl1 { animation: lightSpeaking 0.2s 0s infinite alternate; }
.robot-body.speaking .rl2 { animation: lightSpeaking 0.2s 0.07s infinite alternate; }
.robot-body.speaking .rl3 { animation: lightSpeaking 0.2s 0.14s infinite alternate; }
@keyframes lightSpeaking {
    from { transform: scale(1); opacity: 0.6; }
    to { transform: scale(1.4); opacity: 1; }
}

.robot-status-badge {
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255,255,255,0.6);
    background: rgba(164,93,226,0.15);
    border: 1px solid rgba(164,93,226,0.3);
    border-radius: 20px;
    padding: 4px 12px;
}

/* Dialog panel */
.robot-dialog-panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
}
.robot-speech-bubble {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(164,93,226,0.3);
    border-radius: 16px 16px 16px 4px;
    padding: 16px 18px;
    min-height: 70px;
    position: relative;
}
.speech-bubble-text {
    color: rgba(255,255,255,0.85);
    font-size: 0.9rem;
    line-height: 1.6;
}
.speech-waveform {
    display: none;
    align-items: flex-end;
    gap: 3px;
    height: 28px;
    margin-top: 10px;
}
.speech-waveform.active { display: flex; }
.speech-waveform span {
    display: block;
    width: 5px;
    border-radius: 3px;
    background: linear-gradient(180deg, #C084FC, #A45DE2);
    animation: wavebar 0.6s ease-in-out infinite alternate;
}
.speech-waveform span:nth-child(1)  { height: 8px;  animation-delay: 0.0s; }
.speech-waveform span:nth-child(2)  { height: 18px; animation-delay: 0.1s; }
.speech-waveform span:nth-child(3)  { height: 12px; animation-delay: 0.2s; }
.speech-waveform span:nth-child(4)  { height: 22px; animation-delay: 0.05s; }
.speech-waveform span:nth-child(5)  { height: 16px; animation-delay: 0.15s; }
.speech-waveform span:nth-child(6)  { height: 10px; animation-delay: 0.3s; }
.speech-waveform span:nth-child(7)  { height: 20px; animation-delay: 0.1s; }
.speech-waveform span:nth-child(8)  { height: 14px; animation-delay: 0.25s; }
.speech-waveform span:nth-child(9)  { height: 18px; animation-delay: 0.05s; }
.speech-waveform span:nth-child(10) { height: 8px;  animation-delay: 0.2s; }
@keyframes wavebar {
    from { transform: scaleY(0.4); opacity: 0.6; }
    to   { transform: scaleY(1);   opacity: 1;   }
}

.robot-voice-controls {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}
.robot-ctrl-btn {
    padding: 10px 20px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.25s;
    display: flex;
    align-items: center;
    gap: 7px;
}
.robot-ctrl-btn.play {
    background: linear-gradient(135deg, #A45DE2, #7C3AED);
    color: white;
    box-shadow: 0 4px 15px rgba(164,93,226,0.35);
}
.robot-ctrl-btn.play:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(164,93,226,0.45); }
.robot-ctrl-btn.pause {
    background: rgba(245,158,11,0.2);
    color: #FCD34D;
    border: 1px solid rgba(245,158,11,0.4);
}
.robot-ctrl-btn.pause:hover { background: rgba(245,158,11,0.3); }
.robot-ctrl-btn.stop {
    background: rgba(239,68,68,0.2);
    color: #FCA5A5;
    border: 1px solid rgba(239,68,68,0.3);
}
.robot-ctrl-btn.stop:hover { background: rgba(239,68,68,0.3); }

.robot-speed-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
}
.robot-speed-label { color: rgba(255,255,255,0.5); }
.robot-speed-slider {
    flex: 1;
    accent-color: #A45DE2;
    cursor: pointer;
    height: 4px;
}
#robotSpeedVal { color: #C084FC; font-weight: 700; min-width: 30px; }
</style>
{% endblock %}

{% block body %}
<div class="reservation-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xxl-10">
                <!-- 💎 Carte principale -->
                <div class="reservation-card">
                    <h1 class="main-title">
                        🌸 Réserver votre consultation
                    </h1>
                    
                    <!-- 🎀 En-tête du médecin compact -->
                    <div class="doctor-header">
                        <div class="doctor-info">
                            <div class="doctor-avatar">
                                👨‍⚕️
                            </div>
                            <div class="doctor-details">
                                <h2 class="doctor-name">Dr. {{ creneau.nomMedecin }}</h2>
                                <p class="doctor-specialty">{{ creneau.consultation.categorie }}</p>
                                <p style="color: #666; font-size: 0.95rem;">
                                    <i class="fas fa-video me-1"></i> Consultation vidéo
                                </p>
                            </div>
                        </div>
                        
                        <div class="appointment-details">
                            <div class="detail-item">
                                <span class="detail-icon"><i class="fas fa-calendar-alt"></i></span>
                                <span>{{ creneau.dateDebut|date('d/m/Y') }}</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-icon"><i class="fas fa-clock"></i></span>
                                <span>{{ creneau.dateDebut|date('H:i') }}</span>
                            </div>
                        </div>
                    </div>

                    <!-- 📝 Formulaire de réservation compact -->
                    {{ form_start(form, {'attr': {'id': 'reservationForm', 'novalidate': 'novalidate'}}) }}
                    
                    <div class="form-section">
                        <h3 class="section-title">
                            <i class="fas fa-user-circle me-2"></i> Vos informations
                        </h3>
                        
                        <div class="form-grid">
                            <div class="form-group" id="group_prenom">
                                <label class="form-label required">Prénom</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-user input-icon"></i>
                                    {{ form_widget(form.prenom, {'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Votre prénom'
                                    }}) }}
                                </div>
                                <div class="error-feedback text-danger small mt-1" style="display: none;"></div>
                            </div>
                            
                            <div class="form-group" id="group_nom">
                                <label class="form-label required">Nom</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-user input-icon"></i>
                                    {{ form_widget(form.nom, {'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Votre nom'
                                    }}) }}
                                </div>
                                <div class="error-feedback text-danger small mt-1" style="display: none;"></div>
                            </div>
                            
                            <div class="form-group" id="group_email">
                                <label class="form-label required">Email</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-envelope input-icon"></i>
                                    {{ form_widget(form.email, {'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'votre@email.com'
                                    }}) }}
                                </div>
                                <div class="error-feedback text-danger small mt-1" style="display: none;"></div>
                            </div>
                            
                            <div class="form-group" id="group_telephone">
                                <label class="form-label required">Téléphone</label>
                                <div class="input-wrapper">
                                    <i class="fas fa-phone input-icon"></i>
                                    {{ form_widget(form.telephone, {'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Ex: 12345678'
                                    }}) }}
                                </div>
                                <div class="error-feedback text-danger small mt-1" style="display: none;"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-section">
    <h3 class="section-title">
        <i class="fas fa-heartbeat me-2"></i> Informations médicales
    </h3>
    
    <!-- 👥 Sélection du patient - SOLUTION DÉFINITIVE -->
    <div class="selection-group" id="group_typePatient">
        <label class="selection-label required">Pour qui ?</label>
        <div class="options-grid">
            <div class="option-card" data-choice="MAMAN">
                <span class="option-icon">🤰</span>
                <span class="option-text">Maman</span>
                <input type="radio" 
                       name="reservation[typePatient]" 
                       value="MAMAN" 
                       id="typePatient_MAMAN"
                       class="visually-hidden">
            </div>
            <div class="option-card" data-choice="BEBE">
                <span class="option-icon">👶</span>
                <span class="option-text">Bébé</span>
                <input type="radio" 
                       name="reservation[typePatient]" 
                       value="BEBE" 
                       id="typePatient_BEBE"
                       class="visually-hidden">
            </div>
        </div>
        <div class="error-feedback text-danger small mt-2 text-center" style="display: none;"></div>
        <!-- Input caché pour Symfony -->
        {{ form_widget(form.typePatient, {'attr': {'style': 'display: none;'}}) }}
    </div>
    
    <!-- 📅 Champs conditionnels -->
    <div id="mamanFields" class="conditional-fields" style="display: none;">
        <div class="form-group" id="group_moisGrossesse">
            <label class="form-label">Mois de grossesse</label>
            <div class="input-wrapper">
                <i class="fas fa-baby input-icon"></i>
                {{ form_widget(form.moisGrossesse, {'attr': {
                    'class': 'form-control',
                    'placeholder': 'Exemple : 6'
                }}) }}
            </div>
            <div class="error-feedback text-danger small mt-1" style="display: none;"></div>
        </div>
    </div>
    
    <div id="bebeFields" class="conditional-fields" style="display: none;">
        <div class="form-group" id="group_dateNaissanceBebe">
            <label class="form-label">Date de naissance du bébé</label>
            <div class="input-wrapper">
                <i class="fas fa-birthday-cake input-icon"></i>
                {{ form_widget(form.dateNaissanceBebe, {'attr': {
                    'class': 'form-control',
                    'placeholder': 'JJ/MM/AAAA'
                }}) }}
            </div>
            <div class="error-feedback text-danger small mt-1" style="display: none;"></div>
        </div>
    </div>
    
    <!-- 📝 Notes -->
    <div class="form-group textarea-group" id="group_notes">
        <label class="form-label">Notes supplémentaires</label>
        <div class="input-wrapper">
            <i class="fas fa-edit input-icon" style="top: 20px;"></i>
            {{ form_widget(form.notes, {'attr': {
                'class': 'form-control',
                'placeholder': 'Symptômes, questions ou informations importantes...',
                'rows': 4
            }}) }}
        </div>
        <div class="error-feedback text-danger small mt-1" style="display: none;"></div>
    </div>

    <!-- 🔔 Options de Notification Tactiles -->
    <div class="form-section mt-4">
        <h3 class="section-title">
            <i class="fas fa-bell me-2"></i> Préférences de notification
        </h3>
        <p class="text-muted small mb-3">Comment souhaitez-vous recevoir votre confirmation et vos rappels ?</p>
        
        <div class="notification-options">
            <div class="form-check mb-2">
                {{ form_widget(form.receiveEmail, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(form.receiveEmail, 'Recevoir une confirmation par Email', {'label_attr': {'class': 'form-check-label'}}) }}
            </div>
            <div class="form-check mb-2">
                {{ form_widget(form.receiveSms, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(form.receiveSms, 'Recevoir un SMS de confirmation', {'label_attr': {'class': 'form-check-label'}}) }}
            </div>
        </div>
    </div>

    <!-- 🤖 Bouton Analyser Symptômes -->
    <div class="symptom-ai-banner">
        <div class="symptom-ai-banner-left">
            <div class="symptom-ai-icon-wrap">
                <span class="symptom-ai-pulse"></span>
                🤖
            </div>
            <div>
                <div class="symptom-ai-title">Analyse IA des symptômes</div>
                <div class="symptom-ai-subtitle">Détection faciale intelligente via caméra — Bilan santé en 30 secondes</div>
            </div>
        </div>
        <button type="button" id="btnAnalyserSymptomes" class="btn-analyser">
            <i class="fas fa-camera"></i>
            🔬 Analyser mes symptômes
        </button>
    </div>
</div>
                    <!-- CSRF Token -->
                    {{ form_widget(form._token) }}
                    
                    <!-- ✨ Bouton d'action -->
                    <button type="button" class="action-button" id="btnReserver">
                        <i class="fas fa-calendar-check"></i>
                        Confirmer la réservation
                    </button>
                    
                    {{ form_end(form) }}
                </div>
                
                <!-- 💡 Instructions -->
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">📱</div>
                        <h5 class="feature-title">Préparation technique</h5>
                        <p class="feature-description">Webcam et micro fonctionnels requis pour une consultation optimale.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">🌐</div>
                        <h5 class="feature-title">Connexion internet</h5>
                        <p class="feature-description">Une connexion stable est recommandée pour une expérience fluide.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">📋</div>
                        <h5 class="feature-title">Pièces à préparer</h5>
                        <p class="feature-description">Ayez votre carte vitale et pièce d'identité à portée de main.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🤖 Modal Analyse IA des symptômes -->
<div class="symptom-modal-overlay" id="symptomModal">
    <div class="symptom-modal-box">
        <div class="symptom-modal-header">
            <div class="symptom-modal-header-left">
                <div class="symptom-header-icon">
                    🤖
                </div>
                <div>
                    <h3 class="symptom-modal-title">Analyse IA des symptômes</h3>
                    <p class="symptom-modal-subtitle" id="patientTypeBadge">
                        👤 Sélectionnez le type de patient dans le formulaire
                    </p>
                </div>
            </div>
            <button type="button" class="symptom-close-btn" id="closeSymptomModal">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Étape 1 : Capture caméra -->
        <div class="symptom-step active" id="step1">
            <div class="camera-section">
                <div>
                    <div class="camera-frame">
                        <video id="symptomVideo" autoplay muted playsinline></video>
                        <canvas id="symptomCanvas" style="display: none;"></canvas>
                        <div class="camera-overlay-ui">
                            <div id="faceTargetBox" class="face-target-box">
                                <div class="face-corner tl"></div>
                                <div class="face-corner tr"></div>
                                <div class="face-corner bl"></div>
                                <div class="face-corner br"></div>
                                <div class="face-scan-line"></div>
                                <div class="face-guideline horizontal"></div>
                                <div class="face-guideline vertical"></div>
                            </div>
                        </div>
                    </div>
                    <div class="camera-status-bar" style="display:flex;align-items:center;gap:8px;margin-top:10px;">
                        <span class="camera-dot"></span>
                        <span id="cameraStatusText" style="color:rgba(255,255,255,0.8);font-size:0.9rem;">
                            Initialisation caméra...
                        </span>
                    </div>
                </div>

                <div class="face-detection-status">
                    <div class="face-detection-header">
                        <div class="face-status-main">
                            <span id="faceStatusDot" class="status-dot"></span>
                            <div>
                                <div id="faceStatusText">
                                    En attente de détection...
                                </div>
                                <div class="face-status-sub">
                                    Placez votre visage au centre de l'image et regardez la caméra.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="face-tips">
                        <div class="face-tip">
                            <span>💡</span>
                            <span>Restez immobile quelques secondes pour une meilleure analyse.</span>
                        </div>
                        <div class="face-tip">
                            <span>✨</span>
                            <span>La lumière douce de face améliore la détection des expressions.</span>
                        </div>
                    </div>

                    <button type="button"
                            id="btnCapture"
                            class="btn-capture-personal"
                            disabled>
                        <i class="fas fa-camera"></i>
                        Capturer mon visage et lancer l'analyse
                    </button>
                </div>
            </div>
        </div>

        <!-- Étape 2 : Animation d'analyse IA -->
        <div class="symptom-step" id="step2">
            <div class="ai-analysis-screen">
                <div class="ai-brain-animation">
                    <div class="brain-ring r1"></div>
                    <div class="brain-ring r2"></div>
                    <div class="brain-ring r3"></div>
                    <div class="brain-center">🧠</div>
                </div>
                <div class="ai-analysis-title">Analyse intelligente de vos signes visuels</div>
                <div class="ai-steps-list">
                    <div class="ai-step-item" id="aiStep1">
                        <span class="ai-step-icon">⏳</span>
                        <span>Stabilisation de l'image et préparation des données</span>
                    </div>
                    <div class="ai-step-item" id="aiStep2">
                        <span class="ai-step-icon">⏳</span>
                        <span>Analyse des émotions, fatigue et signes de stress</span>
                    </div>
                    <div class="ai-step-item" id="aiStep3">
                        <span class="ai-step-icon">⏳</span>
                        <span>Génération d'un bilan de santé personnalisé</span>
                    </div>
                    <div class="ai-step-item" id="aiStep4">
                        <span class="ai-step-icon">⏳</span>
                        <span>Préparation de la lecture vocale et du résumé</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Étape 3 : Bilan + robot assistant -->
        <div class="symptom-step" id="step3">
            <div class="bilan-container">
                <div class="bilan-header">
                    <div class="bilan-header-icon">📊</div>
                    <div>
                        <div class="bilan-title">Bilan IA de vos symptômes</div>
                        <p class="bilan-subtitle" id="bilanDate">
                            Généré pour votre consultation en ligne
                        </p>
                    </div>
                </div>

                <div class="captured-face-preview">
                    <img id="capturedFaceImg" alt="Capture du visage" />
                    <div class="face-emotions" id="faceEmotions"></div>
                </div>

                <div class="bilan-content" id="bilanContent">
                    <div class="bilan-loading">
                        <div class="mini-loader"></div>
                        <span>Génération de votre bilan personnalisé en cours...</span>
                    </div>
                </div>

                <!-- Robot lecteur de bilan -->
                <div class="robot-advisor-panel">
                    <div class="robot-figure-wrap">
                        <div id="robotBody" class="robot-body">
                            <div class="robot-antenna">
                                <div class="robot-antenna-ball"></div>
                            </div>
                            <div class="robot-head">
                                <div class="robot-eyes">
                                    <div class="robot-eye">
                                        <div class="robot-pupil"></div>
                                    </div>
                                    <div class="robot-eye">
                                        <div class="robot-pupil"></div>
                                    </div>
                                </div>
                                <div class="robot-mouth">
