{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // 🎭 Gestion des sélecteurs visuels
    document.querySelectorAll('.option-card').forEach(option => {
        option.addEventListener('click', function() {
            const group = this.closest('.options-grid');
            const radio = this.querySelector('input[type="radio"]');
            
            // Désélectionner tous dans le groupe
            group.querySelectorAll('.option-card').forEach(opt => {
                opt.classList.remove('selected');
                opt.querySelector('input[type="radio"]').checked = false;
            });
            
            // Sélectionner celui-ci
            this.classList.add('selected');
            radio.checked = true;
            
            // Afficher/masquer les champs conditionnels
            if (radio.name === 'reservation[typePatient]') {
                const mamanFields = document.getElementById('mamanFields');
                const bebeFields = document.getElementById('bebeFields');
                
                mamanFields.style.display = radio.value === 'MAMAN' ? 'block' : 'none';
                bebeFields.style.display = radio.value === 'BEBE' ? 'block' : 'none';
                
                // Animation d'apparition
                if (mamanFields.style.display === 'block' || bebeFields.style.display === 'block') {
                    const fields = mamanFields.style.display === 'block' ? mamanFields : bebeFields;
                    fields.style.animation = 'fadeIn 0.4s ease';
                }
            }
        });
    });

    // 🔔 Gestion des cartes de notification
    const handleNotifCard = (cardId, checkboxId) => {
        const card = document.getElementById(cardId);
        const checkbox = document.getElementById(checkboxId);
        
        if (card && checkbox) {
            // Initial state
            if (checkbox.checked) card.classList.add('selected');
            
            card.addEventListener('click', () => {
                checkbox.checked = !checkbox.checked;
                if (checkbox.checked) {
                    card.classList.add('selected');
                } else {
                    card.classList.remove('selected');
                }
            });
        }
    };

    handleNotifCard('card_email', 'notif_email');
    handleNotifCard('card_sms', 'notif_sms');

    // 🎯 Validation améliorée
    function validateForm() {
        let isValid = true;
        
        // Validation des champs requis
        const requiredFields = [
            { selector: '[name="reservation[nom]"]', name: 'nom' },
            { selector: '[name="reservation[prenom]"]', name: 'prenom' },
            { selector: '[name="reservation[email]"]', name: 'email' },
            { selector: '[name="reservation[telephone]"]', name: 'telephone' }
        ];
        
        requiredFields.forEach(field => {
            const input = document.querySelector(field.selector);
            const wrapper = input?.closest('.form-group');
            
            if (input && !input.value.trim()) {
                isValid = false;
                input.style.borderColor = '#EF4444';
                input.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.1)';
                
                // Ajouter un message d'erreur
                if (!wrapper.querySelector('.error-message')) {
                    const errorMsg = document.createElement('div');
                    errorMsg.className = 'error-message';
                    errorMsg.textContent = 'Ce champ est obligatoire';
                    errorMsg.style.cssText = `
                        color: #EF4444;
                        font-size: 0.85rem;
                        margin-top: 5px;
                        animation: fadeIn 0.3s ease;
                    `;
                    wrapper.appendChild(errorMsg);
                }
            } else {
                // Supprimer les erreurs si le champ est valide
                input.style.borderColor = '';
                input.style.boxShadow = '';
                const errorMsg = wrapper?.querySelector('.error-message');
                if (errorMsg) errorMsg.remove();
            }
        });
        
        // Validation email
        const emailInput = document.querySelector('[name="reservation[email]"]');
        const emailWrapper = emailInput?.closest('.form-group');
        
        if (emailInput && emailInput.value.trim()) {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(emailInput.value)) {
                isValid = false;
                emailInput.style.borderColor = '#EF4444';
                emailInput.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.1)';
                
                if (!emailWrapper.querySelector('.error-message')) {
                    const errorMsg = document.createElement('div');
                    errorMsg.className = 'error-message';
                    errorMsg.textContent = 'Adresse email invalide';
                    errorMsg.style.cssText = `
                        color: #EF4444;
                        font-size: 0.85rem;
                        margin-top: 5px;
                        animation: fadeIn 0.3s ease;
                    `;
                    emailWrapper.appendChild(errorMsg);
                }
            }
        }
        
        // Validation type patient
        const typePatient = document.querySelector('input[name="reservation[typePatient]"]:checked');
        if (!typePatient) {
            isValid = false;
            const selector = document.querySelector('.selection-group:first-child');
            selector.style.animation = 'shake 0.5s ease';
            setTimeout(() => selector.style.animation = '', 500);
            
            if (!selector.querySelector('.error-message')) {
                const errorMsg = document.createElement('div');
                errorMsg.className = 'error-message';
                errorMsg.textContent = 'Veuillez sélectionner une option';
                errorMsg.style.cssText = `
                    color: #EF4444;
                    font-size: 0.85rem;
                    margin-top: 10px;
                    text-align: center;
                    animation: fadeIn 0.3s ease;
                `;
                selector.appendChild(errorMsg);
            }
        }
        
        return isValid;
    }

    // 🎇 Bouton de réservation
    const btnReserver = document.getElementById('btnReserver');
    const form = document.getElementById('reservationForm');
    const modal = document.getElementById('confirmationModal');
    const overlay = document.querySelector('.modal-overlay');
    const loading = document.getElementById('loadingScreen');
    const btnCloseModal = document.getElementById('btnCloseModal');

    btnReserver.addEventListener('click', async function() {
        if (!validateForm()) {
            // Scroller vers la première erreur
            const firstError = document.querySelector('.error-message');
            if (firstError) {
                firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return;
        }

        // Reset des erreurs précédentes
        document.querySelectorAll('.error-feedback').forEach(el => {
            el.style.display = 'none';
            el.textContent = '';
        });
        document.querySelectorAll('.form-control').forEach(el => {
            el.style.borderColor = '';
            el.style.boxShadow = '';
        });

        // Affichage du chargement
        loading.style.display = 'flex';
        btnReserver.disabled = true;

        try {
            // Envoi AJAX
            const formData = new FormData(form);
            
            const response = await fetch('{{ path('app_creneau_reserver', {'id': creneau.id}) }}', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const contentType = response.headers.get('content-type') || '';
            let data;
            if (contentType.includes('application/json')) {
                data = await response.json();
            } else {
                const text = await response.text();
                throw new Error(`Réponse inattendue du serveur (HTTP ${response.status}). ${text.slice(0, 250)}`);
            }

            if (!response.ok) {
                throw new Error(data?.message || `Erreur serveur (HTTP ${response.status}).`);
            }

            if (data.success) {
                loading.style.display = 'none';
                document.getElementById('referenceNumber').textContent = data.reference;
                document.getElementById('patientNameModal').textContent = data.patientName;

                const emailLi = document.getElementById('notifEmailStatus');
                const smsLi = document.getElementById('notifSmsStatus');
                const email = data.notifStatus?.email;
                const sms = data.notifStatus?.sms;

                if (emailLi) {
                    if (email && typeof email.success !== 'undefined') {
                        emailLi.style.display = '';
                        emailLi.textContent = (email.success ? 'Email : envoyé.' : 'Email : non envoyé.') + (email.message ? ' ' + email.message : '');
                    } else {
                        emailLi.style.display = 'none';
                        emailLi.textContent = '';
                    }
                }

                if (smsLi) {
                    if (sms && typeof sms.success !== 'undefined') {
                        smsLi.style.display = '';
                        smsLi.textContent = (sms.success ? 'SMS : envoyé.' : 'SMS : non envoyé.') + (sms.message ? ' ' + sms.message : '');
                    } else {
                        smsLi.style.display = 'none';
                        smsLi.textContent = '';
                    }
                }

                overlay.style.display = 'flex';
                createConfettiRain();
                playSuccessSound();
            } else {
                loading.style.display = 'none';
                btnReserver.disabled = false;

                if (data.errors) {
                    for (const [field, message] of Object.entries(data.errors)) {
                        const fieldIdMap = {
                            'prenom': 'prenom',
                            'nom': 'nom',
                            'email': 'email',
                            'telephone': 'telephone',
                            'typePatient': 'typePatient',
                            'moisGrossesse': 'moisGrossesse',
                            'dateNaissanceBebe': 'dateNaissanceBebe'
                        };

                        const domId = fieldIdMap[field] || field;
                        const group = document.getElementById('group_' + domId);

                        if (group) {
                            const feedback = group.querySelector('.error-feedback');
                            const input = group.querySelector('.form-control');

                            if (feedback) {
                                feedback.textContent = message;
                                feedback.style.display = 'block';
                            }
                            if (input) {
                                input.style.borderColor = '#EF4444';
                                input.style.boxShadow = '0 0 0 3px rgba(239, 68, 68, 0.1)';
                            }
                        }
                    }

                    btnReserver.style.background = 'linear-gradient(135deg, #EF4444 0%, #F87171 100%)';
                    btnReserver.innerHTML = '<i class="fas fa-exclamation-circle"></i> Erreurs détectées';
                    setTimeout(() => {
                        btnReserver.style.background = '';
                        btnReserver.innerHTML = '<i class="fas fa-calendar-check"></i> Confirmer la réservation';
                    }, 2000);
                } else {
                    alert('❌ ' + (data.message || 'Erreur lors de la réservation. Veuillez réessayer.'));
                }
            }
        } catch (error) {
            loading.style.display = 'none';
            btnReserver.disabled = false;
            console.error('Erreur:', error);
            alert('⚠️ Une erreur est survenue lors de la communication avec le serveur.\n' + (error?.message || ''));
        }
    });

    // Fermeture du modal
    btnCloseModal.addEventListener('click', function() {
        overlay.style.display = 'none';
    });
    
    overlay.addEventListener('click', function(e) {
        if (e.target === overlay) {
            overlay.style.display = 'none';
        }
    });

    // 🎉 Confettis
    function createConfettiRain() {
        const colors = ['#7EC8E3', '#FF9BC9', '#A45DE2', '#4A6FA5', '#FFD166'];
        const emojis = ['🌸', '✨', '🎉', '💫', '🌟', '💖'];
        
        for (let i = 0; i < 40; i++) {
            const confetti = document.createElement('div');
            confetti.innerHTML = emojis[Math.floor(Math.random() * emojis.length)];
            confetti.style.cssText = `
                position: fixed;
                font-size: ${20 + Math.random() * 20}px;
                color: ${colors[Math.floor(Math.random() * colors.length)]};
                top: -50px;
                left: ${Math.random() * 100}vw;
                z-index: 10000;
                pointer-events: none;
                opacity: ${0.7 + Math.random() * 0.3};
                text-shadow: 0 2px 8px currentColor;
                animation: floatDown ${2 + Math.random() * 2}s linear forwards;
            `;
            
            document.body.appendChild(confetti);
            
            setTimeout(() => {
                confetti.remove();
            }, 4000);
        }
    }

    // 🔔 Son de succès
    function playSuccessSound() {
        try {
            const audioContext = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();
            
            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);
            
            oscillator.frequency.setValueAtTime(523.25, audioContext.currentTime);
            oscillator.frequency.setValueAtTime(659.25, audioContext.currentTime + 0.1);
            oscillator.frequency.setValueAtTime(783.99, audioContext.currentTime + 0.2);
            
            gainNode.gain.setValueAtTime(0.2, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
            
            oscillator.start(audioContext.currentTime);
            oscillator.stop(audioContext.currentTime + 0.5);
        } catch (e) {
            console.log('Son non supporté');
        }
    }

    // 🎬 Animation CSS supplémentaire
    const style = document.createElement('style');
    style.textContent = `
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            75% { transform: translateX(8px); }
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        @keyframes floatDown {
            0% { 
                transform: translateY(0) rotate(0deg) scale(1); 
                opacity: 1;
            }
            100% { 
                transform: translateY(100vh) rotate(${360 + Math.random() * 360}deg) 
                         translateX(${Math.random() * 100 - 50}px) scale(0.5);
                opacity: 0;
            }
        }
    `;
    document.head.appendChild(style);
});

// ======================================================
// 🤖 AI SYMPTOM DETECTION - Système de détection faciale
// ======================================================
(function() {
    const GEMINI_API_KEY = 'AIzaSyDemo_Replace_With_Your_Key'; // Remplacer par votre clé API Gemini

    let videoStream = null;
    let faceDetected = false;
    let capturedImageData = null;
    let currentEmotions = {};
    let detectionInterval = null;
    let bilanText = '';

    const btnAnalyser = document.getElementById('btnAnalyserSymptomes');
    const symptomModal = document.getElementById('symptomModal');
    const closeModal = document.getElementById('closeSymptomModal');
    const video = document.getElementById('symptomVideo');
    const canvas = document.getElementById('symptomCanvas');
    const btnCapture = document.getElementById('btnCapture');
    const btnRetry = document.getElementById('btnRetryCapture');
    const btnInject = document.getElementById('btnInjectBilan');
    const patientTypeBadge = document.getElementById('patientTypeBadge');

    // Ouvrir le modal
    if (btnAnalyser) {
        btnAnalyser.addEventListener('click', function() {
            symptomModal.classList.add('active');
            updatePatientBadge();
            startCamera();
        });
    }

    // Fermer le modal
    if (closeModal) {
        closeModal.addEventListener('click', closeSymptomModal);
    }
    if (symptomModal) {
        symptomModal.addEventListener('click', function(e) {
            if (e.target === symptomModal) closeSymptomModal();
        });
    }

    function closeSymptomModal() {
        symptomModal.classList.remove('active');
        stopCamera();
        resetToStep1();
    }

    function updatePatientBadge() {
        const typePatient = document.querySelector('input[name="reservation[typePatient]"]:checked');
        if (typePatient) {
            if (typePatient.value === 'MAMAN') {
                patientTypeBadge.textContent = '🤰 Analyse pour Maman';
                patientTypeBadge.style.background = 'linear-gradient(135deg, rgba(255,155,201,0.3), rgba(255,99,178,0.3))';
            } else if (typePatient.value === 'BEBE') {
                patientTypeBadge.textContent = '👶 Analyse pour Bébé';
                patientTypeBadge.style.background = 'linear-gradient(135deg, rgba(126,200,227,0.3), rgba(74,111,165,0.3))';
            }
        } else {
            patientTypeBadge.textContent = '👤 Sélectionnez le type de patient dans le formulaire';
        }
    }

    async function startCamera() {
        const statusText = document.getElementById('cameraStatusText');
        const cameraDot = document.querySelector('.camera-dot');
        try {
            videoStream = await navigator.mediaDevices.getUserMedia({
                video: { width: { ideal: 640 }, height: { ideal: 480 }, facingMode: 'user' },
                audio: false
            });
            video.srcObject = videoStream;
            statusText.textContent = '📸 Caméra active — Placez votre visage';
            cameraDot.classList.add('active');
            startFaceDetection();
        } catch (err) {
            statusText.textContent = '❌ Accès caméra refusé';
            cameraDot.style.background = '#EF4444';
            console.error('Caméra:', err);
            // Mode demo sans caméra
            simulateFaceDetected();
        }
    }

    function stopCamera() {
        if (videoStream) {
            videoStream.getTracks().forEach(t => t.stop());
            videoStream = null;
        }
        if (detectionInterval) {
            clearInterval(detectionInterval);
            detectionInterval = null;
        }
    }

    function startFaceDetection() {
        const faceStatusDot = document.getElementById('faceStatusDot');
        const faceStatusText = document.getElementById('faceStatusText');
        const faceTargetBox = document.getElementById('faceTargetBox');
        faceStatusDot.classList.add('waiting');
        faceStatusText.textContent = 'Recherche du visage...';

        let detectionCount = 0;
        detectionInterval = setInterval(() => {
            if (video.readyState >= 2) {
                // Simulation de détection basée sur le flux vidéo
                canvas.width = video.videoWidth || 640;
                canvas.height = video.videoHeight || 480;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0);
                const imgData = ctx.getImageData(
                    canvas.width * 0.2, canvas.height * 0.1,
                    canvas.width * 0.6, canvas.height * 0.8
                );
                // Analyse simple : vérifier si pixels non-noirs (visage présent)
                let nonBlack = 0;
                for (let i = 0; i < imgData.data.length; i += 4) {
                    const r = imgData.data[i], g = imgData.data[i+1], b = imgData.data[i+2];
                    if (r > 30 || g > 30 || b > 30) nonBlack++;
                }
                const ratio = nonBlack / (imgData.data.length / 4);
                detectionCount = (ratio > 0.3) ? detectionCount + 1 : Math.max(0, detectionCount - 1);
                if (detectionCount >= 3 && !faceDetected) {
                    simulateFaceDetected();
                }
            }
        }, 500);

        // Fallback: après 4 secondes, activer quand même
        setTimeout(() => {
            if (!faceDetected) simulateFaceDetected();
        }, 4000);
    }

    function simulateFaceDetected() {
        faceDetected = true;
        const faceStatusDot = document.getElementById('faceStatusDot');
        const faceStatusText = document.getElementById('faceStatusText');
        const faceTargetBox = document.getElementById('faceTargetBox');
        faceStatusDot.classList.remove('waiting');
        faceStatusDot.classList.add('detected');
        faceStatusText.textContent = '✅ Visage détecté — Prêt à capturer';
        faceTargetBox.classList.add('detected');
        btnCapture.disabled = false;
        // Générer des émotions simulées
        currentEmotions = generateSimulatedEmotions();
    }

    function generateSimulatedEmotions() {
        const base = { neutral: 0.4, happy: 0.15, sad: 0.08, angry: 0.05, fearful: 0.07, disgusted: 0.05, surprised: 0.1, tired: 0.1 };
        const noisy = {};
        let total = 0;
        for (const [k, v] of Object.entries(base)) {
            noisy[k] = Math.max(0, v + (Math.random() - 0.5) * 0.15);
            total += noisy[k];
        }
        for (const k in noisy) noisy[k] /= total;
        return noisy;
    }

    // Capturer l'image
    if (btnCapture) {
        btnCapture.addEventListener('click', async function() {
            // Capturer l'image du canvas
            canvas.style.display = 'block';
            canvas.width = video.videoWidth || 640;
            canvas.height = video.videoHeight || 480;
            const ctx = canvas.getContext('2d');
            if (videoStream) {
                ctx.drawImage(video, 0, 0);
            } else {
                // Mode demo: créer une image placeholder
                ctx.fillStyle = '#1a1040';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.font = '80px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('👤', canvas.width/2, canvas.height/2 + 30);
            }
            capturedImageData = canvas.toDataURL('image/jpeg', 0.8);
            canvas.style.display = 'none';
            // Aller à l'étape 2
            goToStep(2);
            await runAIAnalysis();
        });
    }

    async function runAIAnalysis() {
        const steps = ['aiStep1','aiStep2','aiStep3','aiStep4'];
        const delays = [800, 1200, 1000, 1400];

        for (let i = 0; i < steps.length; i++) {
            const el = document.getElementById(steps[i]);
            el.classList.add('active');
            el.querySelector('.ai-step-icon').textContent = '⚡';
            await sleep(delays[i]);
            el.classList.remove('active');
            el.classList.add('done');
            el.querySelector('.ai-step-icon').textContent = '✅';
        }

        // Générer le bilan avec Gemini ou localement
        const typePatient = document.querySelector('input[name="reservation[typePatient]"]:checked');
        const patientType = typePatient ? typePatient.value : 'MAMAN';
        const moisGrossesse = document.querySelector('[name="reservation[moisGrossesse]"]')?.value || '';

        bilanText = await generateBilanWithAI(patientType, moisGrossesse, capturedImageData);
        goToStep(3);
        displayBilan(bilanText, patientType);
    }

    async function generateBilanWithAI(patientType, moisGrossesse, imageData) {
        const typeLabel = patientType === 'BEBE' ? 'bébé' : 'femme enceinte/maman';
        const pregnancyInfo = (patientType === 'MAMAN' && moisGrossesse) ? ` au mois ${moisGrossesse} de grossesse` : '';

        const prompt = `Tu es un assistant médical IA de la plateforme Maternia, spécialisé en santé maternelle et pédiatrique.
Analyse les indicateurs visuels détectés sur le visage du patient (${typeLabel}${pregnancyInfo}) et génère un bilan de santé structuré.

Émotions/expressions détectées par caméra :
${Object.entries(currentEmotions).map(([k,v]) => `- ${translateEmotion(k)}: ${Math.round(v*100)}%`).join('\n')}

Génère un bilan COMPLET et STRUCTURÉ avec :
1. **État général observé** (2-3 phrases basées sur les indicateurs visuels)
2. **Signes détectés** (liste de 3-5 observations visuelles pertinentes pour ${typeLabel})
3. **Niveau de stress/fatigue** (score sur 10 avec explication)
4. **Recommandations** (3-4 conseils pratiques adaptés à ${typeLabel}${pregnancyInfo})
5. **Points à aborder avec le médecin** (2-3 sujets importants à mentionner lors de la consultation)

Sois professionnel, bienveillant et précis. Utilise des emojis médicaux appropriés. Format markdown.
IMPORTANT: Rappelle toujours que ce bilan est indicatif et ne remplace pas un diagnostic médical.`;

        try {
            // Tentative avec Gemini API
            if (GEMINI_API_KEY !== 'AIzaSyDemo_Replace_With_Your_Key') {
                const response = await fetch(
                    `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_API_KEY}`,
                    {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{
                                parts: [
                                    { text: prompt },
                                    { inline_data: { mime_type: 'image/jpeg', data: imageData.split(',')[1] } }
                                ]
                            }],
                            generationConfig: { temperature: 0.7, maxOutputTokens: 1024 }
                        })
                    }
                );
                if (response.ok) {
                    const data = await response.json();
                    return data.candidates?.[0]?.content?.parts?.[0]?.text || generateLocalBilan(patientType, moisGrossesse);
                }
            }
        } catch(e) { console.warn('Gemini non disponible, bilan local activé'); }

        // Bilan local si pas de clé API
        return generateLocalBilan(patientType, moisGrossesse);
    }

    function generateLocalBilan(patientType, moisGrossesse) {
        const emotions = currentEmotions;
        const dominant = Object.entries(emotions).sort((a,b) => b[1]-a[1])[0];
        const stressLevel = Math.round((emotions.angry||0)*10 + (emotions.fearful||0)*8 + (emotions.sad||0)*6 + (emotions.tired||0)*7);
        const fatigueLevel = Math.round(((emotions.tired||0) + (emotions.sad||0)*0.5) * 10);
        const wellnessScore = Math.max(1, Math.min(10, 10 - stressLevel));
        const isBebe = patientType === 'BEBE';
        const grossesseInfo = (!isBebe && moisGrossesse) ? ` (${moisGrossesse}e mois de grossesse)` : '';

        const signes = isBebe ? [
            `😴 Niveau de calme/agitation observable: ${Math.round((emotions.neutral||0.4)*100)}%`,
            `😊 Expressivité faciale: ${Math.round(((emotions.happy||0)+(emotions.surprised||0))*100)}%`,
            `😟 Signes d'inconfort possible: ${Math.round(((emotions.sad||0)+(emotions.angry||0))*100)}%`,
        ] : [
            `😴 Indice de fatigue: ${fatigueLevel}/10`,
            `😰 Niveau de stress perçu: ${stressLevel}/10`,
            `🌡️ Teint et expression: Expression ${translateEmotion(dominant[0])} dominante (${Math.round(dominant[1]*100)}%)`,
            `💆 Tension visible: ${emotions.angry > 0.1 ? 'Présente' : 'Faible'}`,
        ];

        const reco = isBebe ? [
            '🤱 Maintenir un contact peau à peau régulier pour rassurer le bébé',
            '😴 Respecter les cycles de sommeil naturels du bébé',
            '🍼 Vérifier la régularité des repas et les signes de confort après alimentation',
            '🌡️ Surveiller la température corporelle et l\'humidité ambiante',
        ] : [
            '🧘 Pratiquer 10-15 min de relaxation ou respiration profonde quotidiennement',
            `💊 S'assurer de prendre les suppléments prescrits${moisGrossesse ? ' (acide folique, fer, calcium)' : ''}`,
            '💧 Boire au moins 2L d\'eau par jour pour rester bien hydratée',
            '🚶 Marche légère de 20-30 min par jour si possible',
            '😴 Viser 8-9h de sommeil par nuit et des siestes si nécessaire',
        ];

        const questions = isBebe ? [
            '📏 Courbe de croissance et poids du bébé',
            '💉 Calendrier vaccinal et prochaines vaccinations',
            '😴 Qualité et durée du sommeil nocturne',
        ] : [
            `📊 Résultats des dernières analyses sanguines${grossesseInfo}`,
            '🩸 Pression artérielle et surveillance de l\'œdème',
            `🤰 ${moisGrossesse ? `Suivi du développement fœtal au ${moisGrossesse}e mois` : 'Planning des prochains examens'}`,
            '💊 Ajustement des suppléments et médications',
        ];

        return `## 📊 État Général Observé

Sur la base de l'analyse faciale réalisée, le patient présente une expression **${translateEmotion(dominant[0])}** dominante. L'indice de bien-être global est estimé à **${wellnessScore}/10**. ${fatigueLevel > 5 ? 'Une fatigue notable est perceptible, ' : 'L\'état général semble satisfaisant, '}ce qui est important à prendre en compte lors de la consultation.

---

## 🔍 Signes Détectés

${signes.map(s => `- ${s}`).join('\n')}

---

## 📈 Indicateurs de Bien-être

| Indicateur | Score | Niveau |
|---|---|---|
| 😌 Bien-être général | ${wellnessScore}/10 | ${'█'.repeat(Math.round(wellnessScore/2))}${'░'.repeat(5-Math.round(wellnessScore/2))} |
| 😰 Stress perçu | ${stressLevel}/10 | ${'█'.repeat(Math.round(stressLevel/2))}${'░'.repeat(5-Math.round(stressLevel/2))} |
| 😴 Fatigue | ${fatigueLevel}/10 | ${'█'.repeat(Math.round(fatigueLevel/2))}${'░'.repeat(5-Math.round(fatigueLevel/2))} |

---

## 💡 Recommandations Personnalisées

${reco.map(r => `- ${r}`).join('\n')}

---

## 🩺 Points à Aborder avec le Médecin

${questions.map(q => `- ${q}`).join('\n')}

---

> ⚠️ **Important** : Ce bilan est généré par l'IA Maternia à partir d'indicateurs visuels. Il est **indicatif uniquement** et ne remplace en aucun cas un diagnostic médical professionnel. Veuillez discuter de ces observations avec votre médecin lors de la consultation.

*Analyse générée le ${new Date().toLocaleDateString('fr-FR')} à ${new Date().toLocaleTimeString('fr-FR')} — Maternia AI*`;
    }

    function translateEmotion(key) {
        const map = { neutral:'neutre', happy:'heureuse', sad:'triste', angry:'stressée', fearful:'anxieuse', disgusted:'inconfortable', surprised:'surprise', tired:'fatiguée' };
        return map[key] || key;
    }

    function displayBilan(text, patientType) {
        document.getElementById('bilanDate').textContent =
            `Généré le ${new Date().toLocaleDateString('fr-FR')} pour ${patientType === 'BEBE' ? 'Bébé' : 'Maman'}`;
        document.getElementById('capturedFaceImg').src = capturedImageData || '';

        // Afficher les émotions
        const emotionsContainer = document.getElementById('faceEmotions');
        const sorted = Object.entries(currentEmotions).sort((a,b) => b[1]-a[1]).slice(0, 5);
        emotionsContainer.innerHTML = sorted.map(([ k, v], i) =>
            `<span class="emotion-chip ${i===0?'dominant':''}">
                ${i===0?'👑':''} ${translateEmotion(k)} ${Math.round(v*100)}%
            </span>`
        ).join('');

        // Afficher le bilan (render markdown simple)
        const bilanContent = document.getElementById('bilanContent');
        bilanContent.innerHTML = renderSimpleMarkdown(text);

        // Animation des barres de score
        setTimeout(() => {
            document.querySelectorAll('.bilan-score-fill').forEach(bar => {
                bar.style.width = bar.getAttribute('data-width') + '%';
            });
        }, 100);

        // Préparer le robot pour la lecture
        robotReady(text, patientType);
    }

    // =========================================
    // 🤖 ROBOT TTS ENGINE — Corrigé
    // =========================================
    let robotUtterance = null;
    let robotIsPaused = false;
    let blinkInterval = null;
    let eyeTrackInterval = null;
    let currentBilanRaw = '';   // stockage au niveau module
    let robotListenersReady = false;

    function robotReady(bilanRaw, patientType) {
        currentBilanRaw = bilanRaw;  // sauvegarder pour les handlers

        const robotSpeechText = document.getElementById('robotSpeechText');
        const greeting = patientType === 'BEBE'
            ? 'Bonjour ! Je suis votre assistant Maternia. Votre bilan pour bébé est prêt. Appuyez sur <strong>Lire le bilan</strong> et je vous lirai vos résultats à voix haute !'
            : 'Bonjour ! Je suis votre assistante Maternia. Votre bilan de santé est prêt. Appuyez sur <strong>Lire le bilan</strong> et je vous lirai vos résultats et conseils personnalisés !';
        robotSpeechText.innerHTML = greeting;

        // Réinitialiser les boutons
        const btnPlay = document.getElementById('btnRobotPlay');
        const btnPause = document.getElementById('btnRobotPause');
        const btnStop = document.getElementById('btnRobotStop');
        btnPlay.innerHTML = '<i class="fas fa-volume-up"></i> Lire le bilan';
        btnPlay.style.display = 'flex';
        btnPause.style.display = 'none';
        btnStop.style.display = 'none';

        // Arrêter toute lecture en cours
        window.speechSynthesis.cancel();
        robotIsPaused = false;

        startBlinking();
        startEyeTracking();

        // Attacher les listeners UNE SEULE FOIS
        if (!robotListenersReady) {
            robotListenersReady = true;
            setupRobotListeners();
        }
    }

    function setupRobotListeners() {
        const btnPlay  = document.getElementById('btnRobotPlay');
        const btnPause = document.getElementById('btnRobotPause');
        const btnStop  = document.getElementById('btnRobotStop');
        const speedSlider = document.getElementById('robotSpeed');
        const speedVal    = document.getElementById('robotSpeedVal');

        // Vitesse
        speedSlider.addEventListener('input', function() {
            speedVal.textContent = parseFloat(this.value).toFixed(1) + '×';
        });

        // ▶ Play / Reprendre
        btnPlay.addEventListener('click', function() {
            if (!('speechSynthesis' in window)) {
                alert('Votre navigateur ne supporte pas la synthèse vocale. Essayez Chrome ou Edge.');
                return;
            }
            if (robotIsPaused) {
                window.speechSynthesis.resume();
                robotIsPaused = false;
                setRobotSpeaking(true);
                btnPause.style.display = 'flex';
                btnStop.style.display  = 'flex';
                btnPlay.style.display  = 'none';
            } else {
                startReading(currentBilanRaw);
            }
        });

        // ⏸ Pause
        btnPause.addEventListener('click', function() {
            window.speechSynthesis.pause();
            robotIsPaused = true;
            setRobotSpeaking(false);
            setRobotStatus('⏸️ Pause', '#F59E0B');
            document.getElementById('robotSpeechText').innerHTML =
                '⏸️ Lecture en pause. Appuyez sur <strong>Reprendre</strong> pour continuer.';
            document.getElementById('speechWaveform').classList.remove('active');
            btnPause.style.display = 'none';
            btnPlay.innerHTML = '<i class="fas fa-play"></i> Reprendre';
            btnPlay.style.display = 'flex';
        });

        // ⏹ Stop
        btnStop.addEventListener('click', function() {
            window.speechSynthesis.cancel();
            robotIsPaused = false;
            setRobotSpeaking(false);
            setRobotStatus('🤖 Maternia AI', '#A45DE2');
            document.getElementById('robotSpeechText').innerHTML =
                'Lecture arrêtée. Appuyez sur <strong>Lire le bilan</strong> pour recommencer.';
            document.getElementById('speechWaveform').classList.remove('active');
            btnPlay.innerHTML = '<i class="fas fa-volume-up"></i> Lire le bilan';
            btnPlay.style.display = 'flex';
            btnPause.style.display = 'none';
            btnStop.style.display  = 'none';
        });
    }

    function startReading(bilanRaw) {
        if (!bilanRaw) {
            document.getElementById('robotSpeechText').innerHTML = '❌ Aucun bilan disponible à lire.';
            return;
        }

        window.speechSynthesis.cancel();
        robotIsPaused = false;

        const textToRead = cleanTextForSpeech(bilanRaw);
        if (!textToRead) return;

        // Délai après cancel() — obligatoire sur Chrome
        setTimeout(() => doSpeak(textToRead), 200);
    }

    function doSpeak(textToRead) {
        function getVoiceAndSpeak() {
            const voices = window.speechSynthesis.getVoices();
            const frVoice = voices.find(v => v.lang.startsWith('fr') && v.name.toLowerCase().includes('google'))
                         || voices.find(v => v.lang.startsWith('fr-'))
                         || voices.find(v => v.lang.startsWith('fr'))
                         || null;

            robotUtterance = new SpeechSynthesisUtterance(textToRead);
            robotUtterance.lang   = 'fr-FR';
            robotUtterance.rate   = parseFloat(document.getElementById('robotSpeed').value) || 0.9;
            robotUtterance.pitch  = 1.1;
            robotUtterance.volume = 1.0;
            if (frVoice) robotUtterance.voice = frVoice;

            robotUtterance.onstart = () => {
                setRobotSpeaking(true);
                setRobotStatus('🔊 En train de parler...', '#10B981');
                document.getElementById('speechWaveform').classList.add('active');
                document.getElementById('btnRobotPlay').style.display  = 'none';
                document.getElementById('btnRobotPause').style.display = 'flex';
                document.getElementById('btnRobotStop').style.display  = 'flex';
                speakWithSubtitles(textToRead);
            };

            robotUtterance.onboundary = (event) => {
                if (event.name === 'word') animateMouthBars();
            };

            robotUtterance.onend = () => {
                setRobotSpeaking(false);
                setRobotStatus('✅ Lecture terminée', '#10B981');
                document.getElementById('speechWaveform').classList.remove('active');
                document.getElementById('robotSpeechText').innerHTML =
                    '✅ Lecture terminée ! Appuyez sur <strong>Ajouter le bilan</strong> ci-dessous pour l\'inclure à votre réservation.';
                document.getElementById('btnRobotPlay').innerHTML = '<i class="fas fa-redo"></i> Relire';
                document.getElementById('btnRobotPlay').style.display  = 'flex';
                document.getElementById('btnRobotPause').style.display = 'none';
                document.getElementById('btnRobotStop').style.display  = 'none';
                robotIsPaused = false;
            };

            robotUtterance.onerror = (e) => {
                console.error('TTS Error:', e.error);
                setRobotSpeaking(false);
                document.getElementById('robotSpeechText').innerHTML =
                    '❌ Erreur de synthèse vocale (<em>' + (e.error || 'inconnue') + '</em>). Essayez Chrome ou Microsoft Edge.';
                document.getElementById('btnRobotPlay').style.display  = 'flex';
                document.getElementById('btnRobotPause').style.display = 'none';
                document.getElementById('btnRobotStop').style.display  = 'none';
            };

            window.speechSynthesis.speak(robotUtterance);
        }

        // Charger les voix (asynchrone sur certains navigateurs)
        const voices = window.speechSynthesis.getVoices();
        if (voices.length > 0) {
            getVoiceAndSpeak();
        } else {
            // Attendre le chargement des voix
            window.speechSynthesis.onvoiceschanged = function() {
                window.speechSynthesis.onvoiceschanged = null;
                getVoiceAndSpeak();
            };
            // Fallback si onvoiceschanged ne se déclenche pas
            setTimeout(() => {
                if (!robotUtterance || !window.speechSynthesis.speaking) {
                    getVoiceAndSpeak();
                }
            }, 800);
        }
    }

    function speakWithSubtitles(fullText) {
        const sentences = fullText.match(/[^.!?]+[.!?]+/g) || [fullText];
        let idx = 0;
        const speechBubble = document.getElementById('robotSpeechText');
        const avgRate = parseFloat(document.getElementById('robotSpeed').value) || 0.9;

        function showNext() {
            if (idx < sentences.length && window.speechSynthesis.speaking) {
                const sentence = sentences[idx].trim();
                if (sentence) {
                    speechBubble.innerHTML = `<span style="color:#C084FC;font-weight:600;">🗣️</span> <em>${sentence}</em>`;
                }
                idx++;
                const wordCount = sentence.split(' ').length;
                const delay = Math.max(1200, (wordCount / (avgRate * 2.5)) * 1000);
                setTimeout(showNext, delay);
            }
        }
        setTimeout(showNext, 200);
    }

    function cleanTextForSpeech(markdown) {
        return markdown
            .replace(/#{1,3} /g, '')
            .replace(/\*\*(.*?)\*\*/g, '$1')
            .replace(/\*(.*?)\*/g, '$1')
            .replace(/^- /gm, '')
            .replace(/^> /gm, '')
            .replace(/\|.+\|/g, '')
            .replace(/---/g, '')
            .replace(/⚠️|📊|🔍|📈|💡|🩺|😌|😰|😴|😴|🤰|👶|💊|💧|🚶|🧘|🤱|🍼|🌡️|📏|💉|📋|✅|❌/g, '')
            .replace(/[█░]/g, '')
            .replace(/\n{2,}/g, '. ')
            .replace(/\n/g, ' ')
            .replace(/\s{2,}/g, ' ')
            .trim();
    }

    function setRobotSpeaking(isSpeaking) {
        const body = document.getElementById('robotBody');
        if (isSpeaking) {
            body.classList.add('speaking');
            body.classList.remove('blinking');
        } else {
            body.classList.remove('speaking');
        }
    }

    function setRobotStatus(text, color) {
        const badge = document.getElementById('robotStatusBadge');
        badge.textContent = text;
        badge.style.color = color;
        badge.style.borderColor = color + '55';
        badge.style.background = color + '22';
    }

    function animateMouthBars() {
        const bars = document.querySelectorAll('.robot-mouth-bar');
        const heights = [6, 10, 14, 10, 6];
        const randomHeights = heights.map(h => h + Math.random() * 6 - 3);
        bars.forEach((bar, i) => {
            bar.style.setProperty('--h', randomHeights[i] + 'px');
        });
    }

    function startBlinking() {
        if (blinkInterval) clearInterval(blinkInterval);
        function doBlink() {
            const body = document.getElementById('robotBody');
            if (!body) return;
            body.classList.add('blinking');
            setTimeout(() => body.classList.remove('blinking'), 150);
        }
        blinkInterval = setInterval(() => {
            doBlink();
            // Double clignement occasionnel
            if (Math.random() < 0.3) setTimeout(doBlink, 250);
        }, 3000 + Math.random() * 2000);
    }

    function startEyeTracking() {
        if (eyeTrackInterval) clearInterval(eyeTrackInterval);
        eyeTrackInterval = setInterval(() => {
            const pupils = document.querySelectorAll('.robot-pupil');
            const xOffset = (Math.random() - 0.5) * 5;
            const yOffset = (Math.random() - 0.5) * 3;
            pupils.forEach(p => {
                p.style.transform = `translate(${xOffset}px, ${yOffset}px)`;
            });
        }, 1500);
    }

    function renderSimpleMarkdown(text) {
        return text
            .replace(/^## (.*)/gm, '<h3 style="color:#C084FC;font-size:1rem;font-weight:700;margin:16px 0 8px;display:flex;align-items:center;gap:8px;">$1</h3>')
            .replace(/\*\*(.*?)\*\*/g, '<strong style="color:#E9D5FF;">$1</strong>')
            .replace(/^- (.*)/gm, '<div style="display:flex;gap:8px;padding:6px 0;color:rgba(255,255,255,0.8);"><span style="flex-shrink:0;">›</span><span>$1</span></div>')
            .replace(/^\|(.+)\|$/gm, (match) => {
                const cells = match.split('|').filter(c => c.trim() && !c.match(/^[-\s]+$/));
                return '<div style="display:flex;gap:12px;padding:6px 8px;background:rgba(255,255,255,0.04);border-radius:6px;margin:3px 0;">' +
                    cells.map(c => `<span style="color:rgba(255,255,255,0.8);font-size:0.88rem;">${c.trim()}</span>`).join('') +
                    '</div>';
            })
            .replace(/^---$/gm, '<hr style="border:none;border-top:1px solid rgba(255,255,255,0.08);margin:16px 0;">')
            .replace(/^> ⚠️ (.*)/gm, '<div style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);border-radius:10px;padding:14px;color:rgba(255,211,99,0.9);font-size:0.88rem;margin:12px 0;">⚠️ $1</div>')
            .replace(/\*(.*?)\*/g, '<em style="color:rgba(255,255,255,0.5);font-size:0.82rem;">$1</em>')
            .replace(/\n/g, '');
    }

    // Injecter le bilan dans les notes
    if (btnInject) {
        btnInject.addEventListener('click', function() {
            const notesField = document.querySelector('textarea[name="reservation[notes]"]') ||
                               document.querySelector('textarea[id*="notes"]');
            if (notesField) {
                const existing = notesField.value.trim();
                const bilanForForm = bilanText.replace(/\*\*/g,'').replace(/#{1,3} /g,'').replace(/---/g,'---').replace(/\n\n+/g,'\n');
                notesField.value = existing
                    ? `${existing}\n\n🤖 BILAN IA DES SYMPTÔMES:\n${bilanForForm}`
                    : `🤖 BILAN IA DES SYMPTÔMES:\n${bilanForForm}`;
                // Animation de confirmation
                notesField.style.borderColor = '#10B981';
                notesField.style.boxShadow = '0 0 0 3px rgba(16,185,129,0.2)';
                setTimeout(() => { notesField.style.borderColor = ''; notesField.style.boxShadow = ''; }, 2000);
                this.innerHTML = '<i class="fas fa-check"></i> Bilan ajouté !';
                this.style.background = 'linear-gradient(135deg, #059669, #047857)';
                setTimeout(() => closeSymptomModal(), 1500);
            }
        });
    }

    // Refaire l'analyse
    if (btnRetry) {
        btnRetry.addEventListener('click', function() {
            resetToStep1();
            faceDetected = false;
            btnCapture.disabled = true;
            startFaceDetection();
        });
    }

    function goToStep(n) {
        document.querySelectorAll('.symptom-step').forEach(s => s.classList.remove('active'));
        document.getElementById('step' + n).classList.add('active');
    }

    function resetToStep1() {
        document.querySelectorAll('.symptom-step').forEach(s => s.classList.remove('active'));
        document.getElementById('step1').classList.add('active');
        document.querySelectorAll('.ai-step-item').forEach(el => {
            el.classList.remove('active','done');
            el.querySelector('.ai-step-icon').textContent = '⏳';
        });
        document.getElementById('btnInjectBilan').innerHTML = '<i class="fas fa-file-medical"></i> Ajouter le bilan à la réservation';
        document.getElementById('btnInjectBilan').style.background = '';
        faceDetected = false;
        btnCapture.disabled = true;
        const dot = document.getElementById('faceStatusDot');
        dot.classList.remove('waiting','detected');
        document.getElementById('faceStatusText').textContent = 'En attente de détection...';
        document.getElementById('faceTargetBox').classList.remove('detected');
        document.querySelector('.camera-dot').classList.remove('active');
        document.getElementById('cameraStatusText').textContent = 'Initialisation caméra...';
    }

    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }
})();
</script>
{% endblock %}