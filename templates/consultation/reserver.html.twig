/* Camera Section */
.camera-section { display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; }
@media(max-width:768px) { .camera-section { grid-template-columns: 1fr; } }

.camera-frame {
    position: relative;
    background: #000;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 4/3;
    border: 2px solid rgba(164,93,226,0.5);
    box-shadow: 0 0 40px rgba(164,93,226,0.2);
}
#symptomVideo {
    width: 100%; height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
}
.camera-overlay-ui {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
}
.face-target-box {
    width: 60%; aspect-ratio: 3/4;
    position: relative;
    border-radius: 50%;
    /* Nouveau design attirant */
    border: 2px dashed rgba(164,93,226,0.3);
    box-shadow: inset 0 0 30px rgba(164,93,226,0.1), 0 0 20px rgba(164,93,226,0.1);
    animation: targetPulse 3s infinite alternate;
}
@keyframes targetPulse {
    0% { border-color: rgba(164,93,226,0.2); transform: scale(0.98); }
    100% { border-color: rgba(164,93,226,0.6); transform: scale(1.02); }
}

.face-corner {
    position: absolute;
    width: 35px; height: 35px;
    border-color: #A45DE2;
    border-style: solid;
    filter: drop-shadow(0 0 8px rgba(164,93,226,0.8));
    transition: all 0.4s ease;
    z-index: 2;
}
.face-corner.tl { top:-5px; left:-5px; border-width:4px 0 0 4px; border-radius:12px 0 0 0; }
.face-corner.tr { top:-5px; right:-5px; border-width:4px 4px 0 0; border-radius:0 12px 0 0; }
.face-corner.bl { bottom:-5px; left:-5px; border-width:0 0 4px 4px; border-radius:0 0 0 12px; }
.face-corner.br { bottom:-5px; right:-5px; border-width:0 4px 4px 0; border-radius:0 0 12px 0; }

.face-scan-line {
    position: absolute;
    left: -15px; right: -15px; top: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #A45DE2, #fff, #A45DE2, transparent);
    animation: scanFace 2.5s cubic-bezier(0.4, 0.0, 0.2, 1) infinite;
    box-shadow: 0 0 15px #A45DE2, 0 0 5px #fff;
    border-radius: 50%;
    z-index: 3;
}
@keyframes scanFace {
    0% { top: -5%; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { top: 105%; opacity: 0; }
}

/* Lignes de repère (nouveau) */
.face-guideline {
    position: absolute;
    background: rgba(164,93,226,0.3);
    z-index: 1;
    transition: all 0.4s ease;
}
.face-guideline.horizontal {
    top: 50%; left: 10%; right: 10%; height: 1px;
}
.face-guideline.vertical {
    left: 50%; top: 10%; bottom: 10%; width: 1px;
}

.face-target-box.detected { 
    border-color: rgba(16,185,129,0.5); 
    box-shadow: inset 0 0 40px rgba(16,185,129,0.2), 0 0 30px rgba(16,185,129,0.2);
    animation: none;
    transform: scale(1);
}
.face-target-box.detected .face-corner { 
    border-color: #10B981; 
    filter: drop-shadow(0 0 10px rgba(16,185,129,0.8));
    transform: scale(1.1);
}
.face-target-box.detected .face-scan-line { 
    background: linear-gradient(90deg, transparent, #10B981, #fff, #10B981, transparent); 
    box-shadow: 0 0 15px #10B981, 0 0 5px #fff;
}
.face-target-box.detected .face-guideline {
    background: rgba(16,185,129,0.3);
}

/* Central crosshair points (nouveau) */
.face-target-box::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 6px; height: 6px;
    background: #A45DE2;
    border-radius: 50%;
    box-shadow: 0 0 10px #A45DE2, 0 0 0 4px rgba(164,93,226,0.3);
    transition: all 0.4s ease;
    z-index: 1;
}
.face-target-box.detected::after {
    background: #10B981;
    box-shadow: 0 0 10px #10B981, 0 0 0 6px rgba(16,185,129,0.2);
}

/* Grid overlay background inside the box */
.face-target-box::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-image: 
        linear-gradient(rgba(164,93,226,0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(164,93,226,0.1) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.5;
    animation: gridMove 10s linear infinite;
    -webkit-mask-image: radial-gradient(circle, black 40%, transparent 70%);
    mask-image: radial-gradient(circle, black 40%, transparent 70%);
    z-index: 0;
}
.face-target-box.detected::before {
    background-image: 
        linear-gradient(rgba(16,185,129,0.15) 1px, transparent 1px),
        linear-gradient(90deg, rgba(16,185,129,0.15) 1px, transparent 1px);
}
@keyframes gridMove {
    0% { background-position: 0 0; }
    100% { background-position: 0 100px; }
}

.camera-status {
