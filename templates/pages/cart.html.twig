{% extends 'base.html.twig' %}

{% block title %}Mon panier - Maternia{% endblock %}

{% block body %}
    <div class="container-fluid py-5 hero-header wow fadeIn" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-lg-7 col-md-12">
                    <h1 class="mb-3 text-primary">Mon panier</h1>
                    <h1 class="mb-5 display-4 text-white">Produits sélectionnés</h1>
                    <p class="lead text-white mb-4">Vérifiez les produits choisis avant de valider votre commande.</p>
                </div>
            </div>
        </div>
    </div>

    <section class="container-fluid py-5 bg-light">
        <div class="container py-4">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h2 class="mb-3">Contenu du panier</h2>
                </div>
                <div class="col-md-6 text-md-end">
                    <a href="{{ path('app_marketplace') }}" class="btn btn-outline-primary btn-border-radius">
                        Continuer mes achats
                    </a>
                </div>
            </div>

            {% if produits is empty %}
                <div class="alert alert-info">
                    Votre panier est vide. Ajoutez des produits depuis la <a href="{{ path('app_marketplace') }}">marketplace</a>.
                </div>
            {% else %}
                <div class="table-responsive bg-white rounded-3 shadow-sm">
                    <table class="table mb-0 align-middle">
                        <thead class="table-light">
                        <tr>
                            <th>Produit</th>
                            <th>Description</th>
                            <th>Prix</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for produit in produits %}
                            <tr>
                                <td>{{ produit.nom }}</td>
                                <td>{{ produit.description|length > 80 ? produit.description|slice(0, 80) ~ '...' : produit.description }}</td>
                                <td>{{ produit.prix }} TND</td>
                                <td class="text-end">
                                    <a href="{{ path('app_cart_remove', { id: produit.id }) }}" class="btn btn-sm btn-outline-danger">
                                        Retirer
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                        <tfoot>
                        <tr>
                            <td colspan="2" class="text-end">Sous-total produits</td>
                            <td colspan="2">{{ total|number_format(2, '.', ' ') }} TND</td>
                        </tr>
                        {% if shippingQuote is not null %}
                        <tr>
                            <td colspan="2" class="text-end">Frais de livraison <small class="text-muted">(estimation POSTE, TN)</small></td>
                            <td colspan="2">{{ shippingQuote.cost|number_format(2, '.', ' ') }} TND</td>
                        </tr>
                        <tr class="table-light">
                            <th colspan="2" class="text-end">Total estimé</th>
                            <th colspan="2">{{ (total + shippingQuote.cost)|number_format(2, '.', ' ') }} TND</th>
                        </tr>
                        {% else %}
                        <tr>
                            <th colspan="2" class="text-end">Total</th>
                            <th colspan="2">{{ total|number_format(2, '.', ' ') }} TND</th>
                        </tr>
                        {% endif %}
                        </tfoot>
                    </table>
                </div>

                <div class="mt-4 bg-white rounded-3 shadow-sm p-4">
                    <h5 class="mb-3">Livraison & validation de la commande</h5>
                    <form method="post" action="{{ path('app_cart_checkout') }}" class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Email (pour recevoir la facture)</label>
                            <input type="email" name="email" class="form-control" placeholder="ex: client@mail.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Téléphone (SMS optionnel)</label>
                            <input type="text" name="telephone" class="form-control" placeholder="+216...">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Adresse</label>
                            <input type="text" name="address" class="form-control" placeholder="Rue, numéro...">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Ville</label>
                            <input type="text" name="city" class="form-control" placeholder="Tunis">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Code postal</label>
                            <input type="text" name="postal_code" class="form-control" placeholder="1000">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Pays</label>
                            <input type="text" name="country" class="form-control" value="TN">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Transporteur</label>
                            <select name="carrier" class="form-select">
                                <option value="POSTE" selected>POSTE</option>
                                <option value="ARAMEX">ARAMEX</option>
                                <option value="DHL">DHL</option>
                            </select>
                        </div>

                        <div class="col-12 d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary px-5 py-3 btn-border-radius">
                                Valider ma commande
                            </button>
                        </div>
                        <div class="col-12">
                            <small class="text-muted">
                                Les frais définitifs sont calculés à la validation selon le poids du panier, le pays et le transporteur choisi (POSTE, Aramex, DHL). Ils seront affichés sur la page de confirmation.
                            </small>
                        </div>
                    </form>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}

