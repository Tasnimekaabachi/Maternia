                {# ===== CHATBOT POPOUT ===== #}
                <style>
                @keyframes slideUp { from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);} }
                @keyframes typing { 0%,60%,100%{transform:translateY(0);}30%{transform:translateY(-6px);} }
