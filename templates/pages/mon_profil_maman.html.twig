                .typing-dot:nth-child(2){animation-delay:0.2s;}.typing-dot:nth-child(3){animation-delay:0.4s;}
                .chat-message{animation:slideUp 0.3s ease;}
                #chat-window{display:none;flex-direction:column;}
                #chat-window.open{display:flex !important;animation:slideUp 0.3s ease;}
                @keyframes spin{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
                </style>

                <button onclick="toggleChat()" id="chat-btn" style="position:fixed;bottom:30px;right:30px;width:62px;height:62px;border-radius:50%;background:linear-gradient(135deg,#e91e8c,#ff6bb3);border:none;color:white;font-size:26px;box-shadow:0 4px 20px rgba(233,30,140,0.5);cursor:pointer;z-index:9999;transition:transform 0.2s;" onmouseover="this.style.transform='scale(1.12)'" onmouseout="this.style.transform='scale(1)'">🤱</button>
                <div id="chat-badge" style="position:fixed;bottom:84px;right:28px;background:#ff4444;color:white;border-radius:50%;width:20px;height:20px;font-size:11px;display:flex;align-items:center;justify-content:center;font-weight:700;z-index:10000;">1</div>
                <div id="chat-window" style="position:fixed;bottom:105px;right:30px;width:370px;height:530px;background:white;border-radius:20px;box-shadow:0 10px 40px rgba(0,0,0,0.18);z-index:9998;overflow:hidden;">
                    <div style="background:linear-gradient(135deg,#e91e8c,#ff6bb3);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <div style="width:42px;height:42px;background:rgba(255,255,255,0.25);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;">🤱</div>
                            <div>
                                <div style="color:white;font-weight:700;font-size:14px;">Maternia AI</div>
                                <div style="color:rgba(255,255,255,0.85);font-size:11px;">● En ligne — Je connais votre profil</div>
                            </div>
                        </div>
                        <div style="display:flex;gap:8px;">
                            <button onclick="clearChat()" title="Nouvelle conversation" style="background:rgba(255,255,255,0.2);border:none;color:white;width:28px;height:28px;border-radius:50%;cursor:pointer;font-size:13px;">🗑️</button>
                            <button onclick="toggleChat()" style="background:rgba(255,255,255,0.2);border:none;color:white;width:28px;height:28px;border-radius:50%;cursor:pointer;font-size:14px;">✕</button>
                        </div>
                    </div>
                    <div id="chatbot-messages" style="height:310px;overflow-y:auto;padding:14px;background:#f9f9f9;scroll-behavior:smooth;">
                        <div class="chat-message" style="display:flex;align-items:flex-start;margin-bottom:12px;">
                            <div style="width:28px;height:28px;background:linear-gradient(135deg,#e91e8c,#ff6bb3);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;margin-right:8px;">🤱</div>
                            <div>
                                <div style="background:white;border-radius:0 12px 12px 12px;padding:10px 13px;max-width:100%;box-shadow:0 1px 4px rgba(0,0,0,0.07);font-size:13px;color:#333;line-height:1.5;">Bonjour ! Je suis Maternia AI 💕 Je connais votre profil médical et je suis là pour vous aider.</div>
                                <div style="font-size:10px;color:#aaa;margin-top:3px;margin-left:4px;" id="msg-time-0"></div>
                            </div>
                        </div>
                    </div>
                    <div style="padding:8px 12px;background:white;border-top:1px solid #f0f0f0;display:flex;gap:5px;flex-wrap:wrap;">
                        {% for suggestion in ['Aliments a eviter ?','Exercices ?','Vitamines ?','Signes alarme ?'] %}
                            <button onclick="askSuggestion('{{ suggestion }}')" style="background:rgba(233,30,140,0.07);color:#e91e8c;border:1px solid rgba(233,30,140,0.2);border-radius:20px;padding:3px 9px;font-size:11px;cursor:pointer;" onmouseover="this.style.background='rgba(233,30,140,0.15)'" onmouseout="this.style.background='rgba(233,30,140,0.07)'">{{ suggestion }}</button>
                        {% endfor %}
                    </div>
                    <div style="padding:10px 14px;background:white;border-top:1px solid #f0f0f0;display:flex;gap:8px;align-items:center;">
                        <input type="text" id="chatbot-input" placeholder="Posez votre question..." style="flex:1;border:2px solid rgba(233,30,140,0.2);border-radius:25px;padding:8px 15px;font-size:13px;outline:none;" onfocus="this.style.borderColor='#e91e8c'" onblur="this.style.borderColor='rgba(233,30,140,0.2)'">
                        <button onclick="sendMessage()" style="width:38px;height:38px;background:linear-gradient(135deg,#e91e8c,#ff6bb3);border:none;border-radius:50%;color:white;cursor:pointer;font-size:15px;flex-shrink:0;">➤</button>
                    </div>
                </div>
                <script>
                const MAMAN_ID = {{ maman.id }};
                function getTime(){var now=new Date();return now.getHours().toString().padStart(2,'0')+':'+now.getMinutes().toString().padStart(2,'0');}
                document.getElementById('msg-time-0').textContent=getTime();
                function toggleChat(){var win=document.getElementById('chat-window');var badge=document.getElementById('chat-badge');win.classList.toggle('open');if(badge)badge.style.display='none';}
                function clearChat(){fetch(`/suivi_grossesse/${MAMAN_ID}/chatbot/reset`,{method:'POST',headers:{'Content-Type':'application/json'}}).then(()=>{document.getElementById('chatbot-messages').innerHTML=`<div class="chat-message" style="display:flex;align-items:flex-start;margin-bottom:12px;"><div style="width:28px;height:28px;background:linear-gradient(135deg,#e91e8c,#ff6bb3);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;margin-right:8px;">🤱</div><div><div style="background:white;border-radius:0 12px 12px 12px;padding:10px 13px;box-shadow:0 1px 4px rgba(0,0,0,0.07);font-size:13px;color:#333;">Nouvelle conversation ! Comment puis-je vous aider ? 💕</div><div style="font-size:10px;color:#aaa;margin-top:3px;margin-left:4px;">${getTime()}</div></div></div>`;});}
                function sendMessage(){var input=document.getElementById('chatbot-input');var question=input.value.trim();if(!question)return;appendMessage(question,'user');input.value='';appendTyping();fetch(`/suivi_grossesse/${MAMAN_ID}/chatbot`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question:question})}).then(r=>r.json()).then(data=>{removeTyping();appendMessage(data.reponse||"Une erreur est survenue.",'bot');}).catch(()=>{removeTyping();appendMessage("Service momentanément indisponible. 💕",'bot');});}
                function askSuggestion(text){document.getElementById('chatbot-input').value=text;sendMessage();}
                function appendMessage(text,sender){var box=document.getElementById('chatbot-messages');var time=getTime();if(sender==='user'){box.innerHTML+=`<div class="chat-message" style="display:flex;justify-content:flex-end;margin-bottom:12px;"><div><div style="background:linear-gradient(135deg,#e91e8c,#ff6bb3);color:white;border-radius:12px 0 12px 12px;padding:10px 13px;max-width:260px;font-size:13px;line-height:1.5;">${text}</div><div style="font-size:10px;color:#aaa;margin-top:3px;text-align:right;margin-right:4px;">${time}</div></div></div>`;}else{box.innerHTML+=`<div class="chat-message" style="display:flex;align-items:flex-start;margin-bottom:12px;"><div style="width:28px;height:28px;background:linear-gradient(135deg,#e91e8c,#ff6bb3);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;margin-right:8px;">🤱</div><div><div style="background:white;border-radius:0 12px 12px 12px;padding:10px 13px;max-width:260px;box-shadow:0 1px 4px rgba(0,0,0,0.07);font-size:13px;color:#333;line-height:1.5;">${text}</div><div style="font-size:10px;color:#aaa;margin-top:3px;margin-left:4px;">${time}</div></div></div>`;}box.scrollTop=box.scrollHeight;}
                function appendTyping(){var box=document.getElementById('chatbot-messages');box.innerHTML+=`<div id="typing-indicator" style="display:flex;align-items:flex-start;margin-bottom:12px;"><div style="width:28px;height:28px;background:linear-gradient(135deg,#e91e8c,#ff6bb3);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;margin-right:8px;">🤱</div><div style="background:white;border-radius:0 12px 12px 12px;padding:12px 16px;box-shadow:0 1px 4px rgba(0,0,0,0.07);"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div></div>`;box.scrollTop=box.scrollHeight;}
                function removeTyping(){var el=document.getElementById('typing-indicator');if(el)el.remove();}
                document.addEventListener('DOMContentLoaded',function(){var input=document.getElementById('chatbot-input');if(input){input.addEventListener('keypress',function(e){if(e.key==='Enter')sendMessage();});}});
                </script>
                {# ===== FIN CHATBOT POPOUT ===== #}

                {# ===== MODAL NUTRITION ===== #}
                {% if nutrition is defined and nutrition %}
                <div id="nutritionModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99999;align-items:center;justify-content:center;padding:20px;">
                    <div style="background:white;border-radius:24px;width:100%;max-width:750px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
                        <div style="background:linear-gradient(135deg,#4caf50,#81c784);padding:20px 24px;border-radius:24px 24px 0 0;display:flex;align-items:center;justify-content:space-between;">
                            <div style="display:flex;align-items:center;gap:12px;">
