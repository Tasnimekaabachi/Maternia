<script>
// Overlay enregistrement
function showRecordingOverlay(btn) {
    var overlay = document.createElement('div');
    overlay.id = 'mic-overlay';
    overlay.className = 'mic-recording-overlay';
    overlay.innerHTML = `
        <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:42px;height:42px;background:#e91e8c;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;animation:mic-pulse 1s infinite;">🎤</div>
            <div>
                <div style="font-weight:700;color:#333;font-size:14px;">Enregistrement en cours...</div>
                <div style="font-size:12px;color:#aaa;" id="mic-timer">0:00</div>
            </div>
        </div>
        <div class="mic-wave">
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <button onclick="stopRecording()" style="background:#e91e8c;border:none;color:white;width:48px;height:48px;border-radius:50%;font-size:20px;cursor:pointer;box-shadow:0 2px 10px rgba(233,30,140,0.4);">⏹️</button>
    `;
    document.body.appendChild(overlay);

    // Timer
    var seconds = 0;
    window.micTimerInterval = setInterval(function() {
        seconds++;
        var min = Math.floor(seconds / 60);
        var sec = seconds % 60;
        var el = document.getElementById('mic-timer');
        if (el) el.textContent = min + ':' + (sec < 10 ? '0' : '') + sec;
    }, 1000);
}

function hideRecordingOverlay() {
    var overlay = document.getElementById('mic-overlay');
    if (overlay) overlay.remove();
    if (window.micTimerInterval) clearInterval(window.micTimerInterval);
}

window.currentRecognition = null;

function stopRecording() {
    if (window.currentRecognition) {
        window.currentRecognition.stop();
    }
    hideRecordingOverlay();
    if (window.currentMicBtn) {
        window.currentMicBtn.classList.remove('recording');
        window.currentMicBtn.innerHTML = '🎤';
    }
}

function startVoice(fieldId, btn) {
    if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
        alert('Votre navigateur ne supporte pas la reconnaissance vocale. Utilisez Chrome ou Edge.');
        return;
    }

    if (btn.classList.contains('recording')) {
        stopRecording();
        return;
    }

    var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    var recognition = new SpeechRecognition();
    recognition.lang = 'fr-FR';
    recognition.continuous = false;
    recognition.interimResults = false;

    window.currentRecognition = recognition;
    window.currentMicBtn = btn;

    btn.classList.add('recording');
    btn.innerHTML = '⏹️';
    showRecordingOverlay(btn);
    recognition.start();

    recognition.onresult = function(event) {
        var transcript = event.results[0][0].transcript;
        var field = document.getElementById(fieldId);
        if (field) {
            field.value = field.value.trim() !== '' ? field.value + ', ' + transcript : transcript;
            field.style.borderColor = '#4caf50';
            setTimeout(() => { field.style.borderColor = ''; }, 2000);
        }
    };

    recognition.onerror = function(event) {
        if (event.error === 'not-allowed') {
            alert('Accès au microphone refusé. Autorisez le microphone dans votre navigateur.');
        }
        stopRecording();
    };

    recognition.onend = function() {
        stopRecording();
    };
}
</script>
{% endblock %}
