    <script>
function startVoice(fieldId, btn) {
    if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
        alert('Votre navigateur ne supporte pas la reconnaissance vocale. Utilisez Chrome ou Edge.');
        return;
    }

    var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    var recognition = new SpeechRecognition();

    recognition.lang = 'fr-FR';
    recognition.continuous = false;
    recognition.interimResults = false;

    // Si déjà en cours d'enregistrement, arrêter
    if (btn.classList.contains('recording')) {
        recognition.stop();
        btn.classList.remove('recording');
        btn.innerHTML = '🎤';
        return;
    }

    // Démarrer l'enregistrement
    btn.classList.add('recording');
    btn.innerHTML = '⏹️';
    btn.title = 'Cliquez pour arrêter';

    recognition.start();

    recognition.onresult = function(event) {
        var transcript = event.results[0][0].transcript;
        var field = document.getElementById(fieldId);
        if (field) {
            // Ajouter au texte existant
            if (field.value.trim() !== '') {
                field.value += ', ' + transcript;
            } else {
                field.value = transcript;
            }
            // Highlight du champ
            field.style.borderColor = '#4caf50';
            setTimeout(() => { field.style.borderColor = 'rgba(233,30,140,0.2)'; }, 2000);
        }
    };

    recognition.onerror = function(event) {
        console.error('Erreur reconnaissance vocale:', event.error);
        if (event.error === 'not-allowed') {
            alert('Accès au microphone refusé. Autorisez le microphone dans votre navigateur.');
        }
        btn.classList.remove('recording');
        btn.innerHTML = '🎤';
        btn.title = 'Dicter par voix';
    };

    recognition.onend = function() {
        btn.classList.remove('recording');
        btn.innerHTML = '🎤';
        btn.title = 'Dicter par voix';
    };
}
</script>
