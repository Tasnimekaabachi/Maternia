{% extends 'base.html.twig' %}

{% block title %}
    {% if mode|default('create') == 'show' %}Mon suivi grossesse - Maternia
    {% elseif mode == 'edit' %}Modifier mon suivi - Maternia
    {% else %}Mon profil maman - Maternia{% endif %}
{% endblock %}

{% if form is defined %}
{% form_theme form _self %}
{% endif %}
{% block form_row %}
    {% set hasErrors = form_errors(form) is not empty %}
    {% set classes = 'form-control form-control-lg' ~ (hasErrors ? ' is-invalid' : '') %}
    <div class="mb-3">
        {{ form_label(form) }}
        {{ form_widget(form, {'attr': {'class': classes}}) }}
        {% if form.vars.help is defined and form.vars.help %}
            <div class="form-text">{{ form.vars.help }}</div>
        {% endif %}
        {% if hasErrors %}
            <div class="invalid-feedback d-block">
                {{ form_errors(form) }}
            </div>
        {% endif %}
    </div>
{% endblock %}
{% block checkbox_row %}
    <div class="mb-3">
        <div class="form-check">
            {{ form_widget(form, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(form, null, {'label_attr': {'class': 'form-check-label'}}) }}
        </div>
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block body %}
    {% if mode|default('create') == 'show' %}
        {# ——— MODE AFFICHAGE (dashboard) ——— #}
        <div class="container-fluid py-5 hero-header wow fadeIn" data-wow-delay="0.1s">
            <div class="container py-5">
                <div class="row g-5">
                    <div class="col-lg-8 col-md-12">
                        <h1 class="mb-3 text-primary">Mon suivi grossesse</h1>
                        <h2 class="mb-4 display-6 text-white">Votre dashboard santé</h2>
                        <p class="lead text-white mb-0">Consultez vos informations et suivez vos indicateurs à tout moment.</p>
                    </div>
                </div>
            </div>
        </div>

        <section class="py-5 wow fadeIn" data-wow-delay="0.1s">
            <div class="container py-5">
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('app_suivi_grossesse_creer') }}">Mon suivi</a></li>
                        <li class="breadcrumb-item active">Mon profil</li>
                    </ol>
                </nav>

                {% if imc_alerte|default(false) %}
                    <div class="alert alert-danger border-2 d-flex align-items-start mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle fa-2x me-3 mt-1"></i>
                        <div class="flex-grow-1">
                            <h5 class="alert-heading mb-2">Attention : IMC à risque</h5>
                            <p class="mb-2">Votre IMC ({{ imc }}) indique un risque pour votre santé pendant la grossesse. Nous vous recommandons de prendre rendez-vous avec un nutritionniste ou votre sage-femme dès que possible.</p>
                            <a href="{{ path('app_appointment') }}" class="btn btn-danger btn-sm">Prendre rendez-vous</a>
                        </div>
                    </div>
                {% endif %}

                <div class="border border-primary rounded-3 bg-light p-4 mb-4 shadow-sm">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <h4 class="text-primary mb-0"><i class="fas fa-baby-carriage me-2"></i> Suivi de grossesse</h4>
                        <a href="{{ path('app_maman_grossesse_edit', { id: maman.id }) }}" class="btn admin-btn-rose btn-sm">
                            <i class="fas fa-edit me-1"></i> Modifier grossesse
                        </a>
                    </div>
                    <hr class="my-3">

                    {% if grossesse %}
                        <div class="row g-3 align-items-end">
                            {% if grossesse.statutGrossesse != 'terminee' %}
                                <div class="col-md-4">
                                    <span class="text-muted small d-block">Semaine actuelle</span>
                                    <strong>{{ grossesse.semaineActuelle ?? '—' }}</strong>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted small d-block">Trimestre</span>
                                    <strong>{{ grossesse.trimestreActuel ?? '—' }}</strong>
                                </div>
                            {% endif %}
                            <div class="col-md-4">
                                <span class="text-muted small d-block">Accouchement prévu</span>
                                <strong>
                                    {% if grossesse.dateAccouchementPrevue %}
                                        {{ grossesse.dateAccouchementPrevue|date('d/m/Y') }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </strong>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted small d-block">Poids actuel (grossesse)</span>
                                <strong>{{ grossesse.poidsActuel is not null ? grossesse.poidsActuel ~ ' kg' : '—' }}</strong>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted small d-block">Statut</span>
                                <strong>{{ grossesse.statutGrossesse ?? '—' }}</strong>
                            </div>
                            <div class="col-12">
                                <span class="text-muted small d-block">Symptômes</span>
                                <span>{{ grossesse.symptomesList|length > 0 ? grossesse.symptomesList|join(', ') : '—' }}</span>
                            </div>
                            {% if grossesse.riskLevel %}
                                <div class="col-12 mt-2">
                                    {% if grossesse.riskLevel == 'High' %}
                                        {% set color = 'danger' %}
                                        {% set icon = '🚨' %}
                                        {% set message = 'Risque élevé détecté ! Consultez un médecin immédiatement.' %}
                                    {% elseif grossesse.riskLevel == 'Mid' %}
                                        {% set color = 'warning' %}
                                        {% set icon = '⚠️' %}
                                        {% set message = 'Risque modéré détecté. Une consultation médicale est recommandée.' %}
                                    {% else %}
                                        {% set color = 'success' %}
                                        {% set icon = '✅' %}
                                        {% set message = 'Grossesse à faible risque. Continuez les consultations régulières.' %}
                                    {% endif %}
                                    <div class="alert alert-{{ color }} border-2 d-flex align-items-start mb-0" role="alert">
                                        <span class="fs-4 me-3">{{ icon }}</span>
                                        <div>
                                            <h6 class="alert-heading mb-1">Niveau de risque ML : <strong>{{ grossesse.riskLevel }}</strong></h6>
                                            <p class="mb-0 small">{{ message }}</p>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>

                        <hr class="my-3">

                        {% set trimestre = grossesse.trimestreActuel ?? null %}
                        {% if trimestre and grossesse.statutGrossesse != 'terminee' %}
                            <div class="mb-3">
                                {% if trimestre == 1 %}
                                    <div class="alert alert-success border-success border-2 mb-0">
                                        <strong>🟢 Vous êtes dans le 1er trimestre de grossesse.</strong><br>
                                        <span class="small text-muted">Cette phase correspond au début du développement du bébé.</span>
                                    </div>
                                {% elseif trimestre == 2 %}
                                    <div class="alert alert-warning border-warning border-2 mb-0">
                                        <strong>🟠 Début du 2ème trimestre.</strong><br>
                                        <span class="small text-muted">La grossesse évolue positivement. Pensez à planifier votre consultation de suivi.</span>
                                    </div>
                                {% else %}
                                    <div class="alert alert-danger border-danger border-2 mb-0">
                                        <strong>🔴 Bienvenue au 3ème trimestre.</strong><br>
                                        <span class="small text-muted">Préparez votre suivi final et les examens avant l'accouchement.</span>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        {% if grossesse.statutGrossesse != 'terminee' %}
                            <div class="row g-3">
                                {% if grossesse_alertes is defined and grossesse_alertes|length > 0 %}
                                    <div class="col-md-6">
                                        <h6 class="text-danger mb-2"><i class="fas fa-exclamation-triangle me-1"></i> Alertes maman</h6>
                                        <ul class="small mb-0 ps-3">
                                            {% for alerte in grossesse_alertes %}
                                                <li>{{ alerte }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% endif %}
                                {% if grossesse_conseil is defined and grossesse_conseil %}
                                    <div class="col-md-6">
                                        <h6 class="text-primary mb-2"><i class="fas fa-lightbulb me-1"></i> Conseil grossesse</h6>
                                        <p class="small mb-0">{{ grossesse_conseil }}</p>
                                    </div>
                                {% endif %}
                            </div>
                        {% elseif bebe_age_mois is defined and bebe_age_mois is not null %}
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <span class="text-muted small d-block">Âge du bébé</span>
                                    {% if bebe_age_mois == 0 and grossesse.dateAccouchementReelle %}
                                        {% set diffJours = (date().timestamp - grossesse.dateAccouchementReelle.timestamp) / 86400 | round %}
                                        {% if diffJours < 7 %}
                                            <strong>{{ diffJours }} jour{{ diffJours > 1 ? 's' : '' }}</strong>
                                        {% else %}
                                            <strong>{{ (diffJours / 7) | round }} semaine{{ (diffJours / 7) | round > 1 ? 's' : '' }}</strong>
                                        {% endif %}
                                    {% else %}
                                        <strong>{{ bebe_age_mois }} mois</strong>
                                    {% endif %}
                                </div>
                                {% if bebe_conseil is defined and bebe_conseil %}
                                    <div class="col-md-8">
                                        <h6 class="text-primary mb-2"><i class="fas fa-baby me-1"></i> Conseil bébé</h6>
                                        <p class="small mb-0">{{ bebe_conseil }}</p>
                                    </div>
                                {% endif %}
                            </div>

                            {# ===== COURBE BÉBÉ ===== #}
                            {% if normes_bebe is defined and normes_bebe is not null and grossesse.poidsNaissance is not null %}
                                <div class="mt-4">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-chart-bar me-2"></i>
                                        Courbe de croissance — Normes OMS
                                    </h5>
                                    {% if evaluation_poids == 'normal' and evaluation_taille == 'normal' %}
                                        <div class="alert alert-success border-2 mb-3">
                                            ✅ <strong>Votre bébé est dans les normes OMS</strong> pour le poids et la taille.
                                        </div>
                                    {% else %}
                                        <div class="alert alert-warning border-2 mb-3">
                                            ⚠️ <strong>Attention :</strong> Certaines mesures sont en dehors des normes OMS. Consultez votre pédiatre.
                                        </div>
                                    {% endif %}
                                    <div class="row g-4">
                                        <div class="col-md-6">
                                            <div class="border border-primary rounded-3 bg-white p-3 shadow-sm">
                                                <h6 class="text-primary mb-1 text-center">⚖️ Poids à la naissance</h6>
                                                <p class="text-center small text-muted mb-2">
                                                    Norme OMS : {{ normes_bebe.poids_min }} — {{ normes_bebe.poids_max }} kg
                                                </p>
                                                <canvas id="chartPoids" height="200"></canvas>
                                                <p class="text-center mt-2 small fw-bold {{ evaluation_poids == 'normal' ? 'text-success' : (evaluation_poids == 'faible' ? 'text-danger' : 'text-warning') }}">
                                                    {% if evaluation_poids == 'normal' %}✅ Normal
                                                    {% elseif evaluation_poids == 'faible' %}🔻 En dessous de la norme
                                                    {% else %}🔺 Au dessus de la norme
                                                    {% endif %}
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="border border-primary rounded-3 bg-white p-3 shadow-sm">
                                                <h6 class="text-primary mb-1 text-center">📏 Taille à la naissance</h6>
                                                <p class="text-center small text-muted mb-2">
                                                    Norme OMS : {{ normes_bebe.taille_min }} — {{ normes_bebe.taille_max }} cm
                                                </p>
                                                <canvas id="chartTaille" height="200"></canvas>
                                                <p class="text-center mt-2 small fw-bold {{ evaluation_taille == 'normal' ? 'text-success' : (evaluation_taille == 'faible' ? 'text-danger' : 'text-warning') }}">
                                                    {% if evaluation_taille == 'normal' %}✅ Normal
                                                    {% elseif evaluation_taille == 'faible' %}🔻 En dessous de la norme
                                                    {% else %}🔺 Au dessus de la norme
                                                    {% endif %}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                                    <script>
                                  new Chart(document.getElementById('chartPoids'), {
    type: 'line',
    data: {
        labels: ['Minimum OMS', 'Votre bébé', 'Maximum OMS'],
        datasets: [{
            label: 'Poids (kg)',
            data: [{{ normes_bebe.poids_min }}, {{ grossesse.poidsNaissance }}, {{ normes_bebe.poids_max }}],
            backgroundColor: 'rgba(233, 30, 140, 0.1)',
            borderColor: '#e91e8c',
            borderWidth: 3,
            pointBackgroundColor: ['#4a90d9', '{{ evaluation_poids == "normal" ? "#4caf50" : "#f44336" }}', '#4a90d9'],
            pointRadius: [8, 12, 8],
            pointBorderColor: 'white',
            pointBorderWidth: 3,
            fill: true,
            tension: 0.4,
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: ctx => ctx.parsed.y + ' kg' } }
        },
        scales: {
            y: { beginAtZero: false, min: 1.5, max: 5.5, ticks: { callback: val => val + ' kg' } }
        }
    }
});

new Chart(document.getElementById('chartTaille'), {
    type: 'line',
    data: {
        labels: ['Minimum OMS', 'Votre bébé', 'Maximum OMS'],
        datasets: [{
            label: 'Taille (cm)',
            data: [{{ normes_bebe.taille_min }}, {{ grossesse.tailleNaissance ?? 0 }}, {{ normes_bebe.taille_max }}],
            backgroundColor: 'rgba(74, 144, 217, 0.1)',
            borderColor: '#4a90d9',
            borderWidth: 3,
            pointBackgroundColor: ['#9c27b0', '{{ evaluation_taille == "normal" ? "#4caf50" : "#f44336" }}', '#9c27b0'],
            pointRadius: [8, 12, 8],
            pointBorderColor: 'white',
            pointBorderWidth: 3,
            fill: true,
            tension: 0.4,
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: ctx => ctx.parsed.y + ' cm' } }
        },
        scales: {
            y: { beginAtZero: false, min: 40, max: 60, ticks: { callback: val => val + ' cm' } }
        }
    }
});
                                    </script>
                                </div>
                            {% endif %}
                            {# ===== FIN COURBE BÉBÉ ===== #}
                        {% endif %}
                    {% else %}
                        <p class="mb-0 text-muted">Aucune grossesse enregistrée pour le moment. Cliquez sur « Mon suivi de grossesse » pour la compléter.</p>
                    {% endif %}
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-lg-6">
                        <div class="d-grid d-md-flex gap-2">
                            <a href="#informations-maman" class="btn btn-outline-primary">
                                <i class="fas fa-user me-1"></i> Mes informations maman
                            </a>
                            <a href="{{ path('app_maman_grossesse_edit', { id: maman.id }) }}" class="btn admin-btn-rose">
                                <i class="fas fa-baby-carriage me-1"></i> Mon suivi de grossesse
                            </a>
                        </div>
                    </div>
                </div>

                <div class="row g-4" id="informations-maman">
                    <div class="col-lg-8">

                        {# ===== CARTE HÔPITAUX ===== #}
                        <div class="border border-primary rounded-3 bg-light p-4 mb-4 shadow-sm">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-map-marker-alt me-2"></i> Hôpitaux & cliniques proches
                            </h5>
                            <p class="small text-muted mb-3">
                                <i class="fas fa-info-circle me-1"></i>
                                Carte des établissements de santé proches de votre position.
                            </p>
                            <div id="map" style="height: 350px; border-radius: 12px;"></div>
                            {# Légende #}
<div class="d-flex flex-wrap gap-3 mt-3 mb-3">
    <span><span style="background:#e91e8c;border-radius:50%;display:inline-block;width:14px;height:14px;"></span> Hôpital</span>
    <span><span style="background:#ff9800;border-radius:50%;display:inline-block;width:14px;height:14px;"></span> Clinique</span>
    <span><span style="background:#4caf50;border-radius:50%;display:inline-block;width:14px;height:14px;"></span> Pharmacie</span>
    <span><span style="background:#4a90d9;border-radius:50%;display:inline-block;width:14px;height:14px;"></span> Votre position</span>
</div>

{# Liste triée par distance #}
<h6 class="text-primary mt-3 mb-2"><i class="fas fa-list me-1"></i> Établissements proches — triés par distance</h6>
<div id="hospitals-list">
    <p class="small text-muted">Chargement en cours...</p>
</div>

                            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
                            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
                            <script>
document.addEventListener('DOMContentLoaded', function () {
    var map = L.map('map').setView([36.8065, 10.1815], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // Icônes par type
    var icons = {
        hospital: L.divIcon({
            html: '<div style="background:#e91e8c;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,0.3);font-size:18px;">🏥</div>',
            iconSize: [36, 36], iconAnchor: [18, 18], className: ''
        }),
        clinic: L.divIcon({
            html: '<div style="background:#ff9800;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,0.3);font-size:18px;">🏨</div>',
            iconSize: [36, 36], iconAnchor: [18, 18], className: ''
        }),
        pharmacy: L.divIcon({
            html: '<div style="background:#4caf50;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,0.3);font-size:18px;">💊</div>',
            iconSize: [36, 36], iconAnchor: [18, 18], className: ''
        }),
        maman: L.divIcon({
            html: '<div style="background:#4a90d9;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,0.3);font-size:18px;">👩</div>',
            iconSize: [36, 36], iconAnchor: [18, 18], className: ''
        })
    };

    // Calcul distance en km
 function calcDistance(lat1, lon1, lat2, lon2) {
    var R = 6371;
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLon = (lon2 - lon1) * Math.PI / 180;
    var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLon/2) * Math.sin(dLon/2);
   return (R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a))).toFixed(1);
}

    // Déterminer le type d'établissement
    function getType(categories) {
        var cat = categories ? categories.join(',') : '';
        if (cat.includes('pharmacy')) return 'pharmacy';
        if (cat.includes('clinic_or_praxis')) return 'clinic';
        return 'hospital';
    }

    function getTypeLabel(type) {
        if (type === 'pharmacy') return '💊 Pharmacie';
        if (type === 'clinic') return '🏨 Clinique';
        return '🏥 Hôpital';
    }

    function loadHospitals(userLat, userLng) {
       fetch(`https://api.geoapify.com/v2/places?categories=healthcare.hospital,healthcare.clinic_or_praxis,healthcare.pharmacy&filter=circle:${userLng},${userLat},7000&limit=15&apiKey=1175ae2fbe7c4881803c31dae105044d`)
            .then(r => r.json())
            .then(data => {
                var results = [];

                (data.features || []).forEach(function(f) {
                    var name     = f.properties.name || 'Établissement de santé';
                    var address  = f.properties.formatted || '';
                    var fLat     = f.geometry.coordinates[1];
                    var fLon     = f.geometry.coordinates[0];
                    var distance = calcDistance(userLat, userLng, fLat, fLon);
                    var cats     = f.properties.categories || [];
                    var type     = getType(cats);
                    var label    = getTypeLabel(type);
                    var mapsUrl  = `https://www.google.com/maps/dir/?api=1&destination=${fLat},${fLon}`;

                    // Marqueur sur la carte
                    L.marker([fLat, fLon], {icon: icons[type]})
                        .addTo(map)
.bindPopup(`
    <div style="min-width:200px">
        <strong>${label}</strong><br>
        <strong>${name}</strong><br>
        <small style="color:#888">${address}</small><br>
        <a href="${mapsUrl}" target="_blank" style="display:block;margin-top:8px;background:#e91e8c;color:white;text-align:center;padding:6px;border-radius:8px;text-decoration:none;font-size:13px;">
            🗺️ Y aller
        </a>
    </div>
`);

                    results.push({ name, address, distance, type, label, mapsUrl });
                });

                // Trier par distance
                results.sort((a, b) => a.distance - b.distance);

                // Afficher la liste sous la carte
var listEl = document.getElementById('hospitals-list');
if (listEl) {
    var visibleCount = 5;
    
function renderList(count) {
    var html = results.slice(0, count).map((h, i) => `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px;margin-bottom:8px;background:white;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,0.08);border-left:4px solid ${h.type === 'hospital' ? '#e91e8c' : h.type === 'pharmacy' ? '#4caf50' : '#ff9800'}">
            <div style="display:flex;align-items:center;gap:10px">
                <span style="font-size:22px">${h.type === 'hospital' ? '🏥' : h.type === 'pharmacy' ? '💊' : '🏨'}</span>
                <div>
                    <div style="font-weight:600;font-size:13px">${h.name}</div>
                    <div style="font-size:11px;color:#888;margin-top:2px">${h.label}</div>
                    <div style="font-size:11px;color:#aaa;margin-top:1px">${h.address.substring(0, 50)}${h.address.length > 50 ? '...' : ''}</div>
                </div>
            </div>
            <div style="text-align:center;flex-shrink:0;margin-left:10px">
                <div style="background:#f0f4ff;border-radius:20px;padding:4px 10px;font-size:12px;font-weight:600;color:#4a90d9;margin-bottom:6px">📍 ${h.distance} km</div>
                <a href="${h.mapsUrl}" target="_blank" style="display:block;background:#e91e8c;color:white;padding:5px 10px;border-radius:8px;text-decoration:none;font-size:11px;font-weight:600">🗺️ Y aller</a>
            </div>
        </div>
    `).join('');

    if (results.length > 5) {
        if (count < results.length) {
            html += `<button onclick="showMore()" style="width:100%;padding:10px;margin-top:4px;background:white;border:2px dashed #4a90d9;color:#4a90d9;border-radius:10px;cursor:pointer;font-weight:600">
                ⬇️ Voir plus (${results.length - count} autres établissements)
            </button>`;
        } else {
            html += `<button onclick="showLess()" style="width:100%;padding:10px;margin-top:4px;background:white;border:2px dashed #888;color:#888;border-radius:10px;cursor:pointer;font-weight:600">
                ⬆️ Voir moins
            </button>`;
        }
    }
    listEl.innerHTML = html;
}

    window.showMore = function() { renderList(results.length); };
    window.showLess = function() { renderList(5); };
    
    renderList(visibleCount);
}
            })
            .catch(err => console.log('Erreur Geoapify:', err));
    }

    var userLat = 36.8065, userLng = 10.1815;

    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function(pos) {
            userLat = pos.coords.latitude;
            userLng = pos.coords.longitude;
            map.setView([userLat, userLng], 13);
            L.marker([userLat, userLng], {icon: icons.maman})
                .addTo(map)
                .bindPopup('<strong>📍 Votre position</strong>')
                .openPopup();
            loadHospitals(userLat, userLng);
        }, function() {
            L.marker([userLat, userLng], {icon: icons.maman})
                .addTo(map)
                .bindPopup('<strong>📍 Tunis (position par défaut)</strong>')
                .openPopup();
            loadHospitals(userLat, userLng);
        });
    } else {
        L.marker([userLat, userLng], {icon: icons.maman})
            .addTo(map)
            .bindPopup('<strong>📍 Tunis (position par défaut)</strong>')
            .openPopup();
        loadHospitals(userLat, userLng);
    }
});
                            </script>
