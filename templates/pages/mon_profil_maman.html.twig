                            </div>
                            <div class="row g-4 mb-4">
                                <div class="col-md-5">
                                    <h6 class="text-success mb-3"><i class="fas fa-chart-pie me-2"></i>Répartition macronutriments</h6>
                                    <canvas id="chartMacros" height="220"></canvas>
                                </div>
                                <div class="col-md-7">
                                    <h6 class="text-success mb-3"><i class="fas fa-balance-scale me-2"></i>Détail macronutriments</h6>
                                    <div class="d-flex flex-column gap-2">
                                        <div style="background:#fce4ec;border-radius:12px;padding:12px 16px;"><div class="d-flex justify-content-between align-items-center mb-1"><span style="font-weight:600;font-size:13px;">🥩 Protéines</span><span style="font-weight:700;color:#c2185b;">{{ nutrition.proteines }}g/jour</span></div><div style="background:rgba(0,0,0,0.1);border-radius:10px;height:8px;"><div style="background:#e91e8c;border-radius:10px;height:8px;width:20%;"></div></div><small class="text-muted">20% des calories — viande, œufs, légumineuses</small></div>
                                        <div style="background:#e8f5e9;border-radius:12px;padding:12px 16px;"><div class="d-flex justify-content-between align-items-center mb-1"><span style="font-weight:600;font-size:13px;">🌾 Glucides</span><span style="font-weight:700;color:#2e7d32;">{{ nutrition.glucides }}g/jour</span></div><div style="background:rgba(0,0,0,0.1);border-radius:10px;height:8px;"><div style="background:#4caf50;border-radius:10px;height:8px;width:50%;"></div></div><small class="text-muted">50% des calories — céréales complètes, fruits</small></div>
                                        <div style="background:#fff8e1;border-radius:12px;padding:12px 16px;"><div class="d-flex justify-content-between align-items-center mb-1"><span style="font-weight:600;font-size:13px;">🥑 Lipides</span><span style="font-weight:700;color:#e65100;">{{ nutrition.lipides }}g/jour</span></div><div style="background:rgba(0,0,0,0.1);border-radius:10px;height:8px;"><div style="background:#ff9800;border-radius:10px;height:8px;width:30%;"></div></div><small class="text-muted">30% des calories — huile d'olive, noix, poisson</small></div>
                                    </div>
                                </div>
                            </div>
                            <h6 class="text-success mb-3"><i class="fas fa-pills me-2"></i>Micronutriments essentiels — Normes OMS</h6>
                            <div class="row g-2 mb-4">
                                {% for micro in nutrition.micronutriments %}
                                    <div class="col-md-4 col-6"><div style="border:2px solid {{ micro.couleur }}20;border-radius:14px;padding:12px;background:{{ micro.couleur }}08;"><div class="d-flex align-items-center gap-2 mb-1"><span style="font-size:18px;">{{ micro.icone }}</span><span style="font-weight:700;font-size:13px;color:{{ micro.couleur }};">{{ micro.valeur }} {{ micro.unite }}</span></div><div style="font-weight:600;font-size:12px;color:#333;">{{ micro.nom }}</div><div style="font-size:10px;color:#888;margin-top:2px;">{{ micro.sources }}</div><span style="font-size:10px;background:{{ micro.couleur }}20;color:{{ micro.couleur }};border-radius:20px;padding:1px 6px;margin-top:4px;display:inline-block;">{{ micro.importance }}</span></div></div>
                                {% endfor %}
                            </div>
                            <h6 class="text-success mb-3"><i class="fas fa-star me-2"></i>Top 5 aliments — Trimestre {{ nutrition.trimestre }}</h6>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                {% for aliment in nutrition.aliments_top %}
                                    <div style="background:linear-gradient(135deg,#e8f5e9,#f1f8e9);border:1px solid #4caf5040;border-radius:12px;padding:10px 14px;display:flex;align-items:center;gap:8px;"><span style="font-size:20px;">{{ aliment.icone }}</span><div><div style="font-weight:700;font-size:12px;color:#2e7d32;">{{ aliment.nom }}</div><div style="font-size:10px;color:#666;">{{ aliment.raison }}</div></div></div>
                                {% endfor %}
                            </div>
                            <div style="background:#f9f9f9;border-left:4px solid #4caf50;border-radius:0 12px 12px 0;padding:12px 16px;"><p class="small text-muted mb-0"><i class="fas fa-info-circle me-1 text-success"></i>Ces valeurs sont calculées selon la formule Mifflin-St Jeor et les recommandations OMS. Consultez toujours votre médecin ou diététicienne pour un suivi personnalisé.</p></div>
                        </div>
                    </div>
                </div>
                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                <script>
                document.addEventListener('DOMContentLoaded',function(){var ctx=document.getElementById('chartMacros');if(!ctx)return;new Chart(ctx,{type:'doughnut',data:{labels:['Protéines 20%','Glucides 50%','Lipides 30%'],datasets:[{data:[{{ nutrition.proteines*4 }},{{ nutrition.glucides*4 }},{{ nutrition.lipides*9 }}],backgroundColor:['#e91e8c','#4caf50','#ff9800'],borderColor:['white','white','white'],borderWidth:3,hoverOffset:8}]},options:{responsive:true,cutout:'65%',plugins:{legend:{position:'bottom',labels:{font:{size:11},padding:10}},tooltip:{callbacks:{label:ctx=>ctx.label+' — '+ctx.parsed+' kcal'}}}}});});
                </script>
                {% endif %}
                {# ===== FIN MODAL NUTRITION ===== #}

                {# ===== MODAL SCANNER ALIMENTS ===== #}
                <div id="scannerModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99999;align-items:center;justify-content:center;padding:20px;">
                    <div style="background:white;border-radius:24px;width:100%;max-width:650px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
                        <div style="background:linear-gradient(135deg,#ff9800,#ffb74d);padding:20px 24px;border-radius:24px 24px 0 0;display:flex;align-items:center;justify-content:space-between;">
                            <div style="display:flex;align-items:center;gap:12px;">
                                <div style="width:48px;height:48px;background:rgba(255,255,255,0.25);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;">🍎</div>
                                <div><div style="color:white;font-weight:700;font-size:18px;">Scanner aliments</div><div style="color:rgba(255,255,255,0.85);font-size:12px;">Vérifiez si un aliment est sûr pendant la grossesse</div></div>
                            </div>
                            <button onclick="document.getElementById('scannerModal').style.display='none'" style="background:rgba(255,255,255,0.2);border:none;color:white;width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:18px;">✕</button>
                        </div>
                        <div style="padding:24px;">
                            <div class="mb-4">
                                <div style="display:flex;gap:10px;margin-bottom:10px;">
                                    <input type="text" id="scanner-input" placeholder="Ex: brie, coca-cola, nutella..." style="flex:1;border:2px solid rgba(255,152,0,0.3);border-radius:12px;padding:12px 16px;font-size:14px;outline:none;" onfocus="this.style.borderColor='#ff9800'" onblur="this.style.borderColor='rgba(255,152,0,0.3)'" onkeypress="if(event.key==='Enter') rechercherAliment()">
                                    <button onclick="rechercherAliment()" style="background:linear-gradient(135deg,#ff9800,#ffb74d);border:none;color:white;padding:12px 20px;border-radius:12px;cursor:pointer;font-weight:600;font-size:14px;">🔍 Chercher</button>
                                </div>
                                <div style="display:flex;gap:8px;margin-bottom:10px;">
                                    <input type="number" id="scanner-barcode" placeholder="Code barre (ex: 3017620422003)" style="flex:1;border:2px solid rgba(255,152,0,0.3);border-radius:12px;padding:12px 16px;font-size:14px;outline:none;" onfocus="this.style.borderColor='#ff9800'" onblur="this.style.borderColor='rgba(255,152,0,0.3)'" onkeypress="if(event.key==='Enter') rechercherParCode()">
                                    <button onclick="rechercherParCode()" style="background:linear-gradient(135deg,#ff9800,#ffb74d);border:none;color:white;padding:12px 20px;border-radius:12px;cursor:pointer;font-weight:600;font-size:14px;">📦 Scanner</button>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    {% for suggestion in ['Brie','Saumon fumé','Nutella','Coca-Cola','Yaourt','Thon'] %}
                                        <button onclick="rechercherRapide('{{ suggestion }}')" style="background:rgba(255,152,0,0.1);color:#e65100;border:1px solid rgba(255,152,0,0.3);border-radius:20px;padding:4px 12px;font-size:12px;cursor:pointer;">{{ suggestion }}</button>
                                    {% endfor %}
                                </div>
                            </div>
                            <div id="scanner-loading" style="display:none;text-align:center;padding:30px;"><div style="font-size:40px;animation:spin 1s linear infinite;">🔍</div><p class="text-muted mt-2">Recherche en cours...</p></div>
                            <div id="scanner-result" style="display:none;"></div>
                            <div id="scanner-empty" style="display:none;text-align:center;padding:30px;"><div style="font-size:48px;">🤷</div><p class="text-muted mt-2">Produit non trouvé. Essayez un autre nom.</p></div>
                        </div>
                    </div>
                </div>
                <script>
                const TRIMESTRE_MAMAN = {{ grossesse ? (grossesse.trimestreActuel ?? 1) : 1 }};
                const INTERDITS = ['alcool','biere','vin','whisky','vodka','camembert','brie','roquefort','livarot','munster','reblochon','saucisson','rillettes','pâté','foie gras','surimi cru','sushi','sashimi','saumon fum','truite fum','hareng fum','cigarette'];
                const MODERATION = ['cafe','cafeine','thon','espadon','requin','maquereau','cola','energy drink','sucre','sirop'];
                function getStatutGrossesse(nom,ingredients){var texte=(nom+' '+(ingredients||'')).toLowerCase();for(var i=0;i<INTERDITS.length;i++){if(texte.includes(INTERDITS[i])){return{niveau:'interdit',couleur:'#f44336',bg:'#ffebee',icone:'🚨',label:'Interdit pendant la grossesse',conseil:getConseilInterdit(INTERDITS[i],TRIMESTRE_MAMAN)};}}for(var j=0;j<MODERATION.length;j++){if(texte.includes(MODERATION[j])){return{niveau:'moderation',couleur:'#ff9800',bg:'#fff8e1',icone:'⚠️',label:'À consommer avec modération',conseil:getConseilModeration(MODERATION[j],TRIMESTRE_MAMAN)};}}return{niveau:'autorise',couleur:'#4caf50',bg:'#e8f5e9',icone:'✅',label:'Autorisé pendant la grossesse',conseil:'Cet aliment peut être consommé sans risque particulier. Continuez à manger varié et équilibré 💕'};}
                function getConseilInterdit(mot,trimestre){if(mot.includes('alcool')||mot.includes('biere')||mot.includes('vin'))return'Zéro alcool pendant toute la grossesse — aucune dose n\'est considérée sûre pour votre bébé.';if(['camembert','brie','roquefort','livarot','munster','reblochon'].includes(mot))return'Les fromages à pâte molle non pasteurisés présentent un risque de listériose. Préférez les fromages à pâte cuite (emmental, comté).';if(['saucisson','rillettes','pâté','foie gras'].includes(mot))return'Les charcuteries crues et les pâtés sont à éviter à cause du risque de toxoplasmose et listériose.';if(['sushi','sashimi','surimi cru'].includes(mot))return'Le poisson cru est déconseillé pendant la grossesse (risque de parasites). Préférez le poisson bien cuit.';if(mot.includes('saumon fum')||mot.includes('truite fum')||mot.includes('hareng fum'))return'Le poisson fumé peut contenir de la listéria. Préférez le saumon bien cuit pendant la grossesse.';return'Cet aliment est déconseillé pendant la grossesse. Consultez votre médecin.';}
                function getConseilModeration(mot,trimestre){if(mot.includes('cafe')||mot.includes('cafeine'))return'Limitez la caféine à 200mg/jour (environ 2 cafés). Au trimestre '+trimestre+', la caféine passe dans le placenta.';if(['thon','espadon','requin','maquereau'].includes(mot))return'Les gros poissons accumulent du mercure. Maximum 1 fois/semaine, et évitez l\'espadon et le requin complètement.';if(mot.includes('cola')||mot.includes('energy'))return'Les boissons sucrées et énergisantes sont à limiter — sucre en excès et caféine déconseillés.';return'À consommer avec modération pendant la grossesse. Privilégiez des alternatives plus saines.';}
                function getNutriscoreStyle(score){if(!score)return{bg:'#9e9e9e',color:'white',label:'?'};var s=score.toUpperCase();var styles={'A':{bg:'#1a9641',color:'white'},'B':{bg:'#6abf69',color:'white'},'C':{bg:'#e6c619',color:'#333'},'D':{bg:'#e67e22',color:'white'},'E':{bg:'#d7191c',color:'white'}};return{...(styles[s]||{bg:'#9e9e9e',color:'white'}),label:s};}
                function afficherResultat(product){var nom=product.product_name||product.product_name_fr||'Produit inconnu';var ingredients=product.ingredients_text||product.ingredients_text_fr||'';var allergenes=product.allergens_tags||[];var nutriscore=product.nutriscore_grade||product.nutrition_grade_fr||null;var image=product.image_front_small_url||product.image_url||null;var statut=getStatutGrossesse(nom,ingredients);var ns=getNutriscoreStyle(nutriscore);var allergenesList=allergenes.map(a=>a.replace('en:','').replace('fr:','')).filter(a=>a).join(', ')||'Aucun détecté';var html=`<div style="border:3px solid ${statut.couleur};border-radius:16px;overflow:hidden;"><div style="background:${statut.bg};padding:16px 20px;display:flex;align-items:center;gap:12px;"><span style="font-size:32px;">${statut.icone}</span><div><div style="font-weight:700;font-size:16px;color:${statut.couleur};">${statut.label}</div><div style="font-size:13px;color:#555;margin-top:2px;">${nom}</div></div>${image?`<img src="${image}" style="width:60px;height:60px;object-fit:contain;border-radius:8px;margin-left:auto;" onerror="this.style.display='none'">`:''}  </div><div style="padding:16px 20px;"><div style="background:#f9f9f9;border-radius:12px;padding:12px 16px;margin-bottom:14px;"><div style="font-weight:600;font-size:12px;color:#555;margin-bottom:8px;">🏷️ Nutriscore — Qualité nutritionnelle</div><div style="display:flex;align-items:center;gap:8px;">${[{l:'A',bg:'#1a9641',c:'white',label:'Excellent'},{l:'B',bg:'#6abf69',c:'white',label:'Bon'},{l:'C',bg:'#e6c619',c:'#333',label:'Moyen'},{l:'D',bg:'#e67e22',c:'white',label:'Mauvais'},{l:'E',bg:'#d7191c',c:'white',label:'Très mauvais'}].map(x=>`<div style="display:flex;flex-direction:column;align-items:center;gap:3px;"><div style="width:32px;height:32px;border-radius:50%;background:${x.l===ns.label?x.bg:'#ddd'};color:${x.l===ns.label?x.c:'#aaa'};font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;transform:${x.l===ns.label?'scale(1.3)':'scale(1)'};box-shadow:${x.l===ns.label?'0 2px 8px rgba(0,0,0,0.25)':'none'};">${x.l}</div>${x.l===ns.label?`<div style="font-size:9px;font-weight:700;color:${x.bg};">${x.label}</div>`:''}</div>`).join('')}</div></div><div style="background:#f5f5f5;border-radius:10px;padding:10px 14px;margin-bottom:14px;"><div style="font-weight:600;font-size:12px;color:#555;margin-bottom:4px;">🌿 Allergènes</div><div style="font-size:12px;color:#333;">${allergenesList}</div></div><div style="background:linear-gradient(135deg,rgba(255,152,0,0.1),rgba(255,183,77,0.1));border-left:4px solid #ff9800;border-radius:0 10px 10px 0;padding:12px 14px;"><div style="font-weight:600;font-size:12px;color:#e65100;margin-bottom:4px;">💕 Conseil — Trimestre ${TRIMESTRE_MAMAN}</div><div style="font-size:12px;color:#555;line-height:1.5;">${statut.conseil}</div></div></div></div>`;document.getElementById('scanner-result').innerHTML=html;document.getElementById('scanner-result').style.display='block';document.getElementById('scanner-loading').style.display='none';document.getElementById('scanner-empty').style.display='none';}
                function rechercherAliment(){var query=document.getElementById('scanner-input').value.trim();if(!query)return;document.getElementById('scanner-loading').style.display='block';document.getElementById('scanner-result').style.display='none';document.getElementById('scanner-empty').style.display='none';fetch(`https://world.openfoodfacts.org/cgi/search.pl?search_terms=${encodeURIComponent(query)}&search_simple=1&action=process&json=1&page_size=1&lc=fr`).then(r=>r.json()).then(data=>{if(data.products&&data.products.length>0){afficherResultat(data.products[0]);}else{document.getElementById('scanner-loading').style.display='none';document.getElementById('scanner-empty').style.display='block';}}).catch(()=>{document.getElementById('scanner-loading').style.display='none';document.getElementById('scanner-empty').style.display='block';});}
                function rechercherParCode(){var code=document.getElementById('scanner-barcode').value.trim();if(!code)return;document.getElementById('scanner-loading').style.display='block';document.getElementById('scanner-result').style.display='none';document.getElementById('scanner-empty').style.display='none';fetch(`https://world.openfoodfacts.org/api/v0/product/${code}.json`).then(r=>r.json()).then(data=>{if(data.status===1&&data.product){afficherResultat(data.product);}else{document.getElementById('scanner-loading').style.display='none';document.getElementById('scanner-empty').style.display='block';}}).catch(()=>{document.getElementById('scanner-loading').style.display='none';document.getElementById('scanner-empty').style.display='block';});}
                function rechercherRapide(nom){document.getElementById('scanner-input').value=nom;rechercherAliment();}
                </script>
                {# ===== FIN MODAL SCANNER ALIMENTS ===== #}

                {# ===== MODAL CALCULATEUR PRÉNOM ===== #}
                <div id="prenomModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99999;align-items:center;justify-content:center;padding:20px;">
                    <div style="background:white;border-radius:24px;width:100%;max-width:650px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
                        <div style="background:linear-gradient(135deg,#e91e8c,#f48fb1);padding:20px 24px;border-radius:24px 24px 0 0;display:flex;align-items:center;justify-content:space-between;">
                            <div style="display:flex;align-items:center;gap:12px;">
                                <div style="width:48px;height:48px;background:rgba(255,255,255,0.25);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;">👶</div>
                                <div><div style="color:white;font-weight:700;font-size:18px;">Calculateur de prénom</div><div style="color:rgba(255,255,255,0.85);font-size:12px;">Signification, popularité et compatibilité</div></div>
                            </div>
                            <button onclick="document.getElementById('prenomModal').style.display='none'" style="background:rgba(255,255,255,0.2);border:none;color:white;width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:18px;">✕</button>
                        </div>
                        <div style="padding:24px;">
                            <div class="mb-4">
                                <div style="display:flex;gap:10px;margin-bottom:10px;">
                                    <input type="text" id="prenom-input" placeholder="Ex: Sofia, Adam, Lina..." style="flex:1;border:2px solid rgba(233,30,140,0.3);border-radius:12px;padding:12px 16px;font-size:14px;outline:none;" onfocus="this.style.borderColor='#e91e8c'" onblur="this.style.borderColor='rgba(233,30,140,0.3)'" onkeypress="if(event.key==='Enter') analyserPrenom()">
                                    <input type="text" id="nom-famille-input" placeholder="Nom de famille (optionnel)" style="flex:1;border:2px solid rgba(233,30,140,0.3);border-radius:12px;padding:12px 16px;font-size:14px;outline:none;" onfocus="this.style.borderColor='#e91e8c'" onblur="this.style.borderColor='rgba(233,30,140,0.3)'" onkeypress="if(event.key==='Enter') analyserPrenom()">
                                </div>
                                <button onclick="analyserPrenom()" style="width:100%;background:linear-gradient(135deg,#e91e8c,#f48fb1);border:none;color:white;padding:12px;border-radius:12px;cursor:pointer;font-weight:600;font-size:14px;">✨ Analyser ce prénom</button>
                                <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:6px;">
                                    {% for suggestion in ['Sofia','Adam','Lina','Youssef','Nour','Rayan','Yasmine','Omar'] %}
                                        <button onclick="rechercherPrenom('{{ suggestion }}')" style="background:rgba(233,30,140,0.08);color:#e91e8c;border:1px solid rgba(233,30,140,0.2);border-radius:20px;padding:4px 12px;font-size:12px;cursor:pointer;">{{ suggestion }}</button>
                                    {% endfor %}
                                </div>
                            </div>
                            <div id="prenom-loading" style="display:none;text-align:center;padding:30px;"><div style="font-size:40px;animation:spin 1s linear infinite;">👶</div><p class="text-muted mt-2">Analyse en cours...</p></div>
                            <div id="prenom-result" style="display:none;"></div>
                        </div>
                    </div>
                </div>
                <script>
                function analyserPrenom(){var prenom=document.getElementById('prenom-input').value.trim();var nomFamille=document.getElementById('nom-famille-input').value.trim();if(!prenom)return;document.getElementById('prenom-loading').style.display='block';document.getElementById('prenom-result').style.display='none';fetch(`/suivi_grossesse/${MAMAN_ID}/prenom`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prenom:prenom,nomFamille:nomFamille})}).then(r=>r.json()).then(data=>{document.getElementById('prenom-loading').style.display='none';if(data.error){document.getElementById('prenom-result').innerHTML='<p class="text-danger">Erreur : '+data.error+'</p>';document.getElementById('prenom-result').style.display='block';return;}afficherResultatPrenom(data);}).catch(()=>{document.getElementById('prenom-loading').style.display='none';document.getElementById('prenom-result').innerHTML='<p class="text-danger">Service indisponible 💕</p>';document.getElementById('prenom-result').style.display='block';});}
                function afficherResultatPrenom(d){var genreEmoji=d.genre==='masculin'?'👦':d.genre==='féminin'?'👧':'👶';var genreCouleur=d.genre==='masculin'?'#2196f3':d.genre==='féminin'?'#e91e8c':'#9c27b0';var similairesHtml=(d.similaires||[]).map(p=>`<button onclick="rechercherPrenom('${p}')" style="background:rgba(233,30,140,0.08);color:#e91e8c;border:1px solid rgba(233,30,140,0.2);border-radius:20px;padding:4px 12px;font-size:12px;cursor:pointer;">${p}</button>`).join('');var compatibiliteHtml='';if(d.score_compatibilite>0){var score=d.score_compatibilite;var stars='';for(var i=1;i<=10;i++){stars+=`<span style="font-size:18px;color:${i<=score?'#e91e8c':'#ddd'};">♥</span>`;}compatibiliteHtml=`<div style="background:linear-gradient(135deg,rgba(233,30,140,0.05),rgba(244,143,177,0.05));border:2px solid rgba(233,30,140,0.2);border-radius:16px;padding:16px;margin-bottom:14px;"><div style="font-weight:700;font-size:13px;color:#e91e8c;margin-bottom:8px;">💑 Compatibilité avec le nom de famille</div><div style="margin-bottom:8px;">${stars}</div><div style="font-size:13px;color:#555;">${d.compatibilite}</div></div>`;}
                var html=`<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;"><div style="width:64px;height:64px;background:linear-gradient(135deg,${genreCouleur},${genreCouleur}88);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:32px;">${genreEmoji}</div><div><div style="font-size:28px;font-weight:800;color:#333;">${d.prenom}</div><div style="display:flex;gap:8px;margin-top:4px;"><span style="background:${genreCouleur}20;color:${genreCouleur};border-radius:20px;padding:2px 10px;font-size:12px;font-weight:600;">${d.genre}</span><span style="background:rgba(255,152,0,0.15);color:#e65100;border-radius:20px;padding:2px 10px;font-size:12px;font-weight:600;">${d.rang}</span></div></div></div><div style="background:#f9f9f9;border-radius:14px;padding:16px;margin-bottom:14px;"><div style="font-weight:700;font-size:13px;color:#555;margin-bottom:6px;">🌍 Origine</div><div style="font-size:14px;color:#333;">${d.origine}</div></div><div style="background:linear-gradient(135deg,rgba(233,30,140,0.05),rgba(244,143,177,0.05));border-left:4px solid #e91e8c;border-radius:0 14px 14px 0;padding:16px;margin-bottom:14px;"><div style="font-weight:700;font-size:13px;color:#e91e8c;margin-bottom:6px;">✨ Signification</div><div style="font-size:14px;color:#333;line-height:1.6;">${d.signification}</div></div><div style="background:#e3f2fd;border-radius:14px;padding:16px;margin-bottom:14px;"><div style="font-weight:700;font-size:13px;color:#1565c0;margin-bottom:6px;">📊 Popularité</div><div style="font-size:14px;color:#333;">${d.popularite}</div></div>${compatibiliteHtml}<div style="background:#fff8e1;border-radius:14px;padding:16px;margin-bottom:14px;"><div style="font-weight:700;font-size:13px;color:#e65100;margin-bottom:6px;">💡 Le saviez-vous ?</div><div style="font-size:13px;color:#555;line-height:1.5;">${d.anecdote}</div></div><div><div style="font-weight:700;font-size:13px;color:#9c27b0;margin-bottom:8px;">💕 Prénoms similaires</div><div style="display:flex;flex-wrap:wrap;gap:6px;">${similairesHtml}</div></div>`;
                document.getElementById('prenom-result').innerHTML=html;document.getElementById('prenom-result').style.display='block';}
                function rechercherPrenom(prenom){document.getElementById('prenom-input').value=prenom;analyserPrenom();}
                </script>
