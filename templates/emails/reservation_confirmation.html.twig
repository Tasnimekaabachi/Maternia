<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmation de Réservation - Maternia</title>
    <style>
        /* RESET COMPLET */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
        }
        
        body {
            background-color: #f5f0ff;
            padding: 30px 20px;
        }
        
        /* CONTAINER PRINCIPAL */
        .container {
            max-width: 580px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(255, 105, 180, 0.15);
        }
        
        /* HEADER SANS CADRE */
        .header {
            background: linear-gradient(135deg, #ff7eb3 0%, #ff4d94 50%, #a05aff 100%);
            padding: 40px 35px;
        }
        
        .brand {
            font-size: 32px;
            font-weight: 800;
            color: white;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }
        
        .badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.15);
            padding: 6px 16px;
            border-radius: 40px;
            color: white;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }
        
        /* SECTION SUCCÈS */
        .success {
            padding: 40px 35px 25px;
            text-align: center;
            border-bottom: 1px solid #f0e6ff;
        }
        
        .check {
            font-size: 50px;
            margin-bottom: 15px;
        }
        
        .success h1 {
            font-size: 26px;
            font-weight: 800;
            color: #ff4d94;
            margin-bottom: 10px;
        }
        
        .greeting {
            color: #555;
            font-size: 16px;
            line-height: 1.5;
            margin-bottom: 25px;
        }
        
        .greeting strong {
            color: #ff4d94;
        }
        
        /* RÉFÉRENCE */
        .ref-box {
            background: #fff5fa;
            padding: 18px 25px;
            display: inline-block;
            border-radius: 50px;
            margin-top: 5px;
        }
        
        .ref-label {
            font-size: 11px;
            color: #ff4d94;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }
        
        .ref-code {
            font-size: 22px;
            font-weight: 800;
            color: #a05aff;
            letter-spacing: 1px;
        }
        
        /* SECTIONS GÉNÉRIQUES */
        .section {
            padding: 30px 35px;
            border-bottom: 1px solid #f0e6ff;
        }
        
        .section:last-of-type {
            border-bottom: none;
        }
        
        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
        }
        
        .title-icon {
            font-size: 24px;
        }
        
        .title-text {
            font-size: 18px;
            font-weight: 700;
            color: #333;
            letter-spacing: -0.3px;
        }
        
        /* GRILLE 2 COLONNES */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        
        .info-item {
            margin-bottom: 0;
        }
        
        .info-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: #999;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
        }
        
        .info-value {
            font-size: 16px;
            font-weight: 600;
            color: #333;
            line-height: 1.4;
        }
        
        .info-value.pink {
            color: #ff4d94;
        }
        
        .info-value.purple {
            color: #a05aff;
        }
        
        /* BADGE STATUT */
        .status {
            background: #e3f7e7;
            color: #1e7b4c;
            padding: 4px 12px;
            border-radius: 40px;
            font-size: 13px;
            font-weight: 700;
            display: inline-block;
        }
        
        /* MEET CARD */
        .meet {
            background: linear-gradient(135deg, #1a73e8 0%, #8a4fff 100%);
            padding: 35px;
            border-radius: 20px;
            text-align: center;
            color: white;
        }
        
        .meet-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }
        
        .meet h3 {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 10px;
        }
        
        .meet p {
            font-size: 15px;
            opacity: 0.9;
            line-height: 1.6;
            margin-bottom: 25px;
        }
        
        .meet-btn {
            display: inline-block;
            background: white;
            color: #1a73e8;
            font-weight: 700;
            font-size: 16px;
            padding: 14px 35px;
            border-radius: 40px;
            text-decoration: none;
            margin-bottom: 15px;
        }
        
        .meet-link {
            font-size: 11px;
            color: rgba(255,255,255,0.6);
            word-break: break-all;
        }
        
        /* ÉTAPES SANS AUCUN CADRE */
        .step-item {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
        }
        
        .step-item:last-child {
            margin-bottom: 0;
        }
        
        .step-num {
            font-size: 18px;
            font-weight: 700;
            color: #ff4d94;
            min-width: 30px;
        }
        
        .step-desc {
            flex: 1;
        }
        
        .step-desc strong {
            display: block;
            font-size: 16px;
            color: #333;
            margin-bottom: 5px;
        }
        
        .step-desc p {
            font-size: 14px;
            color: #666;
            line-height: 1.5;
        }
        
        .phone {
            color: #a05aff;
            font-weight: 600;
        }
        
        /* ALERTE */
        .alert {
            background: #fff9e6;
            padding: 20px;
            border-radius: 16px;
            display: flex;
            gap: 15px;
        }
        
        .alert-icon {
            font-size: 22px;
        }
        
        .alert-text strong {
            display: block;
            color: #b45b0a;
            margin-bottom: 5px;
            font-size: 15px;
        }
        
        .alert-text p {
            color: #7a4d0e;
            font-size: 14px;
            line-height: 1.6;
        }
        
        .ref-highlight {
            background: #b45b0a;
            color: white;
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 700;
        }
        
        /* FOOTER */
        .footer {
            background: #1a0b2e;
            padding: 40px 35px;
            text-align: center;
        }
        
        .footer-brand {
            font-size: 26px;
            font-weight: 800;
            color: #ff99c8;
            margin-bottom: 8px;
        }
        
        .footer-tag {
            color: #aaa;
            font-size: 13px;
            margin-bottom: 25px;
        }
        
        .footer-links {
            display: flex;
            justify-content: center;
            gap: 25px;
            margin-bottom: 20px;
        }
        
        .footer-links a {
            color: #777;
            text-decoration: none;
            font-size: 12px;
        }
        
        .copyright {
            color: #555;
            font-size: 11px;
            line-height: 1.6;
        }
        
        .footer-email {
            color: #ff99c8;
            font-size: 12px;
            margin-top: 15px;
            opacity: 0.8;
        }
        
        /* RESPONSIVE */
        @media (max-width: 480px) {
            .grid-2 {
                grid-template-columns: 1fr;
                gap: 15px;
            }
            
            .section {
                padding: 25px 20px;
            }
            
            .header {
                padding: 30px 20px;
            }
            
            .footer-links {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <div class="header">
            <div class="brand">🌸 Maternia</div>
            <div class="badge">✨ CONFIRMATION DE RÉSERVATION</div>
        </div>
        
        <!-- SUCCÈS -->
        <div class="success">
            <div class="check">✅</div>
            <h1>Rendez-vous confirmé !</h1>
            <div class="greeting">
                Bonjour <strong>{{ reservation.prenomClient }} {{ reservation.nomClient }}</strong>,<br>
                votre réservation a bien été enregistrée.
            </div>
            <div class="ref-box">
                <div class="ref-label">Référence</div>
                <div class="ref-code">#{{ reservation.reference }}</div>
            </div>
        </div>
        
        <!-- INFOS PATIENT -->
        <div class="section">
            <div class="section-title">
                <span class="title-icon">👤</span>
                <span class="title-text">Informations Personnelles</span>
            </div>
            
            <div class="grid-2">
                <div class="info-item">
                    <div class="info-label">Nom complet</div>
                    <div class="info-value">{{ reservation.prenomClient }} {{ reservation.nomClient }}</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Type de patient</div>
                    <div class="info-value pink">
                        {% if reservation.typePatient == 'BEBE' %}👶 Bébé{% else %}🤰 Maman{% endif %}
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Email</div>
                    <div class="info-value purple">{{ reservation.emailClient }}</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Téléphone</div>
                    <div class="info-value">{{ reservation.telephoneClient }}</div>
                </div>
                
                {% if reservation.typePatient == 'MAMAN' and reservation.moisGrossesse %}
                <div class="info-item">
                    <div class="info-label">Mois de grossesse</div>
                    <div class="info-value pink">{{ reservation.moisGrossesse }} mois</div>
                </div>
                {% endif %}
                
                {% if reservation.typePatient == 'BEBE' and reservation.dateNaissanceBebe %}
                <div class="info-item">
                    <div class="info-label">Date de naissance</div>
                    <div class="info-value">{{ reservation.dateNaissanceBebe|date('d/m/Y') }}</div>
                </div>
                {% endif %}
            </div>
        </div>
        
        <!-- DÉTAILS RENDEZ-VOUS -->
        {% if reservation.consultationCreneau %}
        <div class="section">
            <div class="section-title">
                <span class="title-icon">📅</span>
                <span class="title-text">Détails du Rendez-vous</span>
            </div>
            
            <div class="grid-2">
                <div class="info-item">
                    <div class="info-label">Médecin</div>
                    <div class="info-value pink">Dr. {{ reservation.consultationCreneau.nomMedecin }}</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Spécialité</div>
                    <div class="info-value">{{ reservation.consultationCreneau.consultation.categorie }}</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Date</div>
                    <div class="info-value purple">
                        {% if reservation.consultationCreneau.jour %}
                            📆 {{ reservation.consultationCreneau.jour|date('d/m/Y') }}
                        {% else %}
                            📆 {{ reservation.dateReservation|date('d/m/Y') }}
                        {% endif %}
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Horaire</div>
                    <div class="info-value purple">
                        {% if reservation.consultationCreneau.heureDebut and reservation.consultationCreneau.heureFin %}
                            🕐 {{ reservation.consultationCreneau.heureDebut|date('H:i') }} — {{ reservation.consultationCreneau.heureFin|date('H:i') }}
                        {% else %}
                            À confirmer
                        {% endif %}
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Statut</div>
                    <div class="info-value">
                        <span class="status">✅ {{ reservation.statutReservation }}</span>
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Durée</div>
                    <div class="info-value">
                        ⏱ {% if reservation.consultationCreneau.dureeMinutes %}{{ reservation.consultationCreneau.dureeMinutes }} min{% else %}30 min{% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        
        <!-- GOOGLE MEET -->
        {% if meetLink %}
        <div class="section">
            <div class="meet">
                <div class="meet-icon">📹</div>
                <h3>Consultation Vidéo</h3>
                <p>
                    Votre rendez-vous se déroule en ligne via <strong>Google Meet</strong>.<br>
                    Cliquez sur le bouton ci-dessous pour rejoindre la salle.
                </p>
                <a href="{{ meetLink }}" class="meet-btn" target="_blank">📹 Rejoindre Google Meet</a>
                <div class="meet-link">{{ meetLink }}</div>
            </div>
        </div>
        {% endif %}
        
        <!-- ÉTAPES - SANS AUCUN CADRE NI CERCLE -->
        <div class="section">
            <div class="section-title">
                <span class="title-icon">📋</span>
                <span class="title-text">À faire avant votre consultation</span>
            </div>
            
            <!-- Étape 1 -->
            <div class="step-item">
                <div class="step-num">1.</div>
                <div class="step-desc">
                    <strong>📋 Préparez vos documents</strong>
                    <p>Carnet de santé, ordonnances récentes, résultats d'analyses</p>
                </div>
            </div>
            
            <!-- Étape 2 -->
            <div class="step-item">
                <div class="step-num">2.</div>
                <div class="step-desc">
                    <strong>⏰ Soyez ponctuel(le)</strong>
                    <p>Présentez-vous 10 minutes avant le début de la consultation</p>
                </div>
            </div>
            
            {% if meetLink %}
            <!-- Étape 3 -->
            <div class="step-item">
                <div class="step-num">3.</div>
                <div class="step-desc">
                    <strong>🎥 Testez votre matériel</strong>
                    <p>Vérifiez votre caméra, microphone et connexion internet</p>
                </div>
            </div>
            
            <!-- Étape 4 -->
            <div class="step-item">
                <div class="step-num">4.</div>
                <div class="step-desc">
                    <strong>🔗 Rejoignez le Meet</strong>
                    <p>Cliquez sur le lien Google Meet 5 minutes avant l'heure prévue</p>
                </div>
            </div>
            
            <!-- Étape 5 -->
            <div class="step-item">
                <div class="step-num">5.</div>
                <div class="step-desc">
                    <strong>📞 En cas d'empêchement</strong>
                    <p>Contactez-nous au <span class="phone">+216 XX XXX XXX</span> au moins 24h à l'avance</p>
                </div>
            </div>
            {% else %}
            <!-- Étape 3 (sans Meet) -->
            <div class="step-item">
                <div class="step-num">3.</div>
                <div class="step-desc">
                    <strong>📞 En cas d'empêchement</strong>
                    <p>Contactez-nous au <span class="phone">+216 XX XXX XXX</span> au moins 24h à l'avance</p>
                </div>
            </div>
            {% endif %}
        </div>
        
        <!-- ALERTE -->
        <div class="section">
            <div class="alert">
                <div class="alert-icon">⚠️</div>
                <div class="alert-text">
                    <strong>Important</strong>
                    <p>
                        Conservez votre numéro de référence <span class="ref-highlight">#{{ reservation.reference }}</span> 
                        — il est indispensable pour toute modification ou annulation.
                    </p>
                </div>
            </div>
        </div>
        
        <!-- FOOTER -->
        <div class="footer">
            <div class="footer-brand">🌸 Maternia</div>
            <div class="footer-tag">Votre santé maternelle & pédiatrique</div>
            <div class="footer-links">
                <a href="#">Aide</a>
                <a href="#">Conditions</a>
                <a href="#">Confidentialité</a>
            </div>
            <div class="copyright">
                © {{ "now"|date("Y") }} Maternia Clinique<br>
                Tous droits réservés
            </div>
            <div class="footer-email">{{ reservation.emailClient }}</div>
        </div>
    </div>
</body>
</html>