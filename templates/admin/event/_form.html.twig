{% form_theme form 'bootstrap_5_layout.html.twig' %}
<style>
    .invalid-feedback, .alert-danger, .text-danger, .form-errors, ul li { color: #dc3545 !important; }
    .form-errors ul { list-style: none; padding-left: 0; }
</style>

{{ form_start(form, {'attr': {'class': 'admin-event-form', 'id': 'admin-event-form', 'novalidate': 'novalidate'}}) }}

{% if not form.vars.valid %}
    <div class="alert alert-danger mb-4 shadow-sm border-0" style="border-radius: 12px; border-left: 5px solid #dc3545 !important;">
        <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-triangle fa-2x me-3 text-danger"></i>
            <div>
                <h6 class="mb-1 fw-bold text-danger">Erreurs de validation</h6>
                <p class="mb-0 text-muted small">Veuillez vérifier les champs surlignés en rouge.</p>
                {{ form_errors(form) }}
            </div>
        </div>
    </div>
{% endif %}

<div class="row g-4">
    {# Left Column #}
    <div class="col-lg-8">
        <div class="form-section mb-4">
            <h6 class="form-section-title">
                <i class="fas fa-info-circle"></i>Informations générales
            </h6>
            
            {% if form.title is defined %}
                <div class="mb-4">
                    {{ form_label(form.title, 'Titre de l\'événement', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-font"></i>
                        </span>
                        {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le titre de l\'événement'}}) }}
                    </div>
                    {{ form_errors(form.title) }}
                </div>
            {% endif %}

            {% if form.description is defined %}
                <div class="mb-4">
                    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': 'Décrivez votre événement en détail...'}}) }}
                    {{ form_errors(form.description) }}
                    <div class="form-text mt-2">
                        <i class="fas fa-align-left me-1"></i>Détails, programme et informations importantes.
                    </div>
                </div>
            {% endif %}

            {% if form.capacity is defined %}
                <div class="mb-3">
                    {{ form_label(form.capacity, 'Nombre maximum de participants', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-users"></i>
                        </span>
                        {{ form_widget(form.capacity, {'attr': {'class': 'form-control', 'placeholder': 'ex: 20'}}) }}
                    </div>
                    {{ form_errors(form.capacity) }}
                    <div class="form-text mt-2">
                        <i class="fas fa-info-circle me-1"></i>Laissez vide pour un nombre de places illimité.
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="form-section">
            <h6 class="form-section-title">
                <i class="fas fa-calendar-alt"></i>Date et heure
            </h6>

            <!-- Weekly Toggle -->
            <div class="mb-4">
                <div class="mode-selector">
                    <div class="form-check form-switch custom-switch-large reversed-layout">
                        <span class="custom-switch-text fw-bold">Événement hebdomadaire</span>
                        {{ form_widget(form.isWeekly, {'label': false, 'attr': {'class': 'form-check-input weekly-toggle-admin', 'id': 'admin-is-weekly-toggle'}}) }}
                    </div>
                </div>
                {{ form_errors(form.isWeekly) }}
                <div class="form-text mt-2">
                    <i class="fas fa-info-circle me-1"></i>Cochez pour un événement récurrent (ex: tous les lundis).
                </div>
            </div>
            
            <div id="admin-date-selection-section">
                <div class="row">
                    {% if form.startAt is defined %}
                        <div class="col-md-6 mb-4">
                            {{ form_label(form.startAt, 'Date et heure de début', {'label_attr': {'class': 'form-label'}}) }}
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-play-circle"></i>
                                </span>
                                {{ form_widget(form.startAt, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            {{ form_errors(form.startAt) }}
                        </div>
                    {% endif %}

                    {% if form.endAt is defined %}
                        <div class="col-md-6 mb-4">
                            {{ form_label(form.endAt, 'Date et heure de fin', {'label_attr': {'class': 'form-label'}}) }}
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-stop-circle"></i>
                                </span>
                                {{ form_widget(form.endAt, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            {{ form_errors(form.endAt) }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div id="admin-weekly-selection-section" style="display: none;">
                <div class="row">
                    <div class="col-md-4 mb-4">
                        {{ form_label(form.dayOfWeek, 'Jour de la semaine', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.dayOfWeek, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.dayOfWeek) }}
                    </div>
                    <div class="col-md-4 mb-4">
                        {{ form_label(form.startTime, 'Heure de début', {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-clock"></i>
                            </span>
                            {{ form_widget(form.startTime, {'attr': {'class': 'form-control time-input-admin'}}) }}
                        </div>
                        {{ form_errors(form.startTime) }}
                    </div>
                    <div class="col-md-4 mb-4">
                        {{ form_label(form.endTime, 'Heure de fin', {'label_attr': {'class': 'form-label'}}) }}
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-clock"></i>
                            </span>
                            {{ form_widget(form.endTime, {'attr': {'class': 'form-control time-input-admin'}}) }}
                        </div>
                        {{ form_errors(form.endTime) }}
                    </div>
                </div>
            </div>

            <!-- Admin Duration Preview -->
            <div id="admin-duration-preview">
                <i class="fas fa-hourglass-half"></i>
                <span class="fw-bold">Durée estimée :</span>
                <span id="admin-duration-value">--</span>
            </div>
        </div>

        <div class="form-section mb-4">
            <h6 class="form-section-title">
                <i class="fas fa-map-marker-alt"></i>Localisation
            </h6>
            
            {% if form.location is defined %}
                <div class="mb-4">
                    {{ form_label(form.location, 'Lieu de l\'événement', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-map-marker-alt"></i>
                        </span>
                        {{ form_widget(form.location, {'attr': {'class': 'form-control', 'placeholder': 'Adresse ou lien de visioconférence', 'id': 'event_location_input'}}) }}
                        <button class="btn btn-outline-primary" type="button" id="toggle-map-picker" 
                                title="Choisir sur la carte">
                            <i class="fas fa-map-marked-alt"></i> Carte
                        </button>
                    </div>
                    
                    <div id="map-picker-container" style="display: none; margin-top: 1rem;">
                        <div class="map-picker-header mb-2 d-flex justify-content-between align-items-center bg-light p-2 rounded-top border-bottom">
                            <span class="text-xs text-muted small"><i class="fas fa-info-circle me-1"></i> Cliquez ou déplacez le marqueur pour définir l'adresse</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="close-map-picker">Fermer</button>
                        </div>
                        <div id="location-map" style="height: 300px; width: 100%; border-radius: 0 0 12px 12px; border: 1px solid #dee2e6; z-index: 10;"></div>
                    </div>
                    {{ form_errors(form.location) }}
                </div>

                <!-- Indoor/Outdoor Toggle & Weather -->
                <div class="mb-4" id="outdoor-section">
                    <div class="mode-selector">
                        <div class="form-check form-switch custom-switch-large reversed-layout">
                            <span class="custom-switch-text fw-bold">Événement en extérieur ?</span>
                            {{ form_widget(form.isOutdoor, {'label': false, 'attr': {'class': 'form-check-input', 'id': 'outdoor-toggle'}}) }}
                        </div>
                    </div>
                    
                    <div id="weather-widget-container" style="display: none;">
                        <div class="weather-widget premium-weather-card">
                            <div class="weather-card-header">
                                <span class="weather-title"><i class="fas fa-cloud-sun me-2"></i>Météo prévue</span>
                                <span id="weather-date" class="weather-date-badge"></span>
                            </div>
                            <div class="weather-card-body">
                                <div id="weather-loading" class="text-center py-3">
                                    <div class="spinner-border text-pink spinner-border-sm" role="status"></div>
                                    <span class="ms-2">Chargement de la météo...</span>
                                </div>
                                <div id="weather-data" style="display: none;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="weather-main">
                                            <img id="weather-icon" src="" alt="Icon" />
                                            <div class="weather-temp-group">
                                                <span id="weather-temp" class="weather-temp">--°C</span>
                                                <span id="weather-desc" class="weather-desc">--</span>
                                            </div>
                                        </div>
                                        <div class="weather-details">
                                            <div class="weather-detail-item">
                                                <i class="fas fa-tint"></i>
                                                <span id="weather-humidity">--%</span>
                                            </div>
                                            <div class="weather-detail-item">
                                                <i class="fas fa-wind"></i>
                                                <span id="weather-wind">-- km/h</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="weather-error" class="alert alert-soft-danger py-2 mb-0 mt-2" style="display: none; font-size: 0.85rem;">
                                    <i class="fas fa-exclamation-circle me-1"></i>
                                    <span id="weather-error-msg">Impossible de récupérer la météo.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {# Matériel Nécessaire Section (Moved to Main Column) #}
        <div class="form-section mb-4">
            <h6 class="form-section-title">
                <i class="fas fa-box-open text-primary me-2"></i>Matériel Nécessaire
            </h6>
            
            <div class="mb-4">
                <div class="mode-selector">
                    <div class="form-check form-switch custom-switch-large reversed-layout">
                        <span class="custom-switch-text fw-bold">Besoin de matériel spécifique ?</span>
                        {{ form_widget(form.showRequirements, {'label': false, 'attr': {'class': 'form-check-input requirements-toggle', 'id': 'requirement-toggle'}}) }}
                    </div>
                </div>
                <div class="form-text mt-2 text-muted">
                    <i class="fas fa-info-circle me-1"></i>Cochez si vous avez besoin que les participants apportent du matériel
                </div>
            </div>

            <div id="requirements-selection-section" style="display: none;">
                <div class="requirements-selection-grid mt-4">
                    <div class="requirements-grid">
                        {% for requirement in form.requirements %}
                            <div class="requirement-card" data-id="{{ requirement.vars.id }}">
                                <div class="requirement-card-body">
                                    <div class="requirement-icon-wrapper">
                                        <div class="requirement-icon">
                                            <i class="fas fa-magic"></i>
                                        </div>
                                    </div>
                                    <div class="requirement-info">
                                        <span class="requirement-name">{{ requirement.vars.label }}</span>
                                        <span class="requirement-details">Matériel à prévoir</span>
                                    </div>
                                    <div class="requirement-action">
                                        {{ form_widget(requirement, {'label': false, 'attr': {'class': 'd-none requirement-checkbox'}}) }}
                                        <div class="custom-checkbox-indicator">
                                            <i class="fas fa-plus"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="requirement-selected-badge">
                                    <i class="fas fa-check"></i>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Right Column #}
    <div class="col-lg-4">
        <div class="form-section mb-4">
            <h6 class="form-section-title">
                <i class="fas fa-tag"></i>Catégorie
            </h6>
            
            {% if form.eventCat is defined %}
                <div class="mb-3">
                    {{ form_label(form.eventCat, 'Sélectionnez une catégorie', {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-list"></i>
                        </span>
                        {{ form_widget(form.eventCat, {'attr': {'class': 'form-select'}}) }}
                    </div>
                    {{ form_errors(form.eventCat) }}
                    <div class="form-text mt-2">
                        <i class="fas fa-tags me-1"></i>Choisissez la catégorie qui correspond le mieux.
                    </div>
                </div>
            {% endif %}
        </div>


        <div class="form-section">
            <h6 class="form-section-title">
                <i class="fas fa-image"></i>Image de l'événement
            </h6>
            
            {# Hidden field for the selected image #}
            {{ form_widget(form.selectedImage, {'attr': {'class': 'd-none', 'id': 'event_selectedImage'}}) }}
            
            {% if existingImages is defined and existingImages|length > 0 %}
                <div class="image-gallery-wrapper">
                    <div class="image-gallery-grid">
                        {% for image in existingImages %}
                            <div class="gallery-item-admin" data-image="{{ image }}">
                                <div class="gallery-item-inner">
                                    <img src="{{ asset('img/events/' ~ image) }}" 
                                         class="gallery-image" 
                                         alt="{{ image }}">
                                    <div class="gallery-overlay">
                                        <i class="fas fa-check"></i>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="form-text mt-3">
                        <i class="fas fa-info-circle me-1"></i>Cliquez sur une image pour la sélectionner.
                    </div>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>Aucune image disponible dans /public/img/events/
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('Admin Form: Initializing all scripts...');

    // ===== 1. Weekly Toggle Logic =====
    const adminWeeklyToggle = document.getElementById('admin-is-weekly-toggle') || 
                            document.querySelector('.weekly-toggle-admin') ||
                            document.getElementById('event_isWeekly') || 
                            document.querySelector('input[type="checkbox"][name*="isWeekly"]');
                            
    const adminDateSection = document.getElementById('admin-date-selection-section');
    const adminWeeklySection = document.getElementById('admin-weekly-selection-section');
    const adminDurationValue = document.getElementById('admin-duration-value');
    const locationInput = document.getElementById('event_location_input') || document.querySelector('[name*="[location]"]');

    console.log('Admin Form: locationInput =', locationInput);

    function calculateAdminDuration() {
        if (!adminDurationValue) return;
        
        try {
            const isWeekly = adminWeeklyToggle && adminWeeklyToggle.checked;
            let startVal, endVal;
            
            if (isWeekly) {
                const startTimeEl = document.querySelector('input[name*="startTime"]');
                const endTimeEl = document.querySelector('input[name*="endTime"]');
                startVal = startTimeEl ? startTimeEl.value : '';
                endVal = endTimeEl ? endTimeEl.value : '';
            } else {
                const startAtEl = document.querySelector('input[name*="startAt"]') || document.querySelector('select[name*="startAt"]');
                const endAtEl = document.querySelector('input[name*="endAt"]') || document.querySelector('select[name*="endAt"]');
                startVal = startAtEl ? startAtEl.value : '';
                endVal = endAtEl ? endAtEl.value : '';
            }
            
            if (!startVal || !endVal) {
                adminDurationValue.textContent = '--';
                return;
            }

            let start, end;
            if (isWeekly) {
                start = new Date('2000-01-01T' + startVal);
                end = new Date('2000-01-01T' + endVal);
            } else {
                start = new Date(startVal);
                end = new Date(endVal);
            }

            if (isNaN(start.getTime()) || isNaN(end.getTime())) {
                adminDurationValue.textContent = 'Invalide';
                return;
            }

            if (end <= start) {
                adminDurationValue.textContent = 'Fin < Début';
                return;
            }

            const diff = end - start;
            const h = Math.floor(diff / 3600000);
            const m = Math.floor((diff % 3600000) / 60000);
            
            let text = '';
            if (h > 0) text += h + 'h ';
            if (m > 0) text += m + 'min';
            
            adminDurationValue.textContent = text || '0min';
        } catch (e) {
            console.error('Admin: Duration calculation error:', e);
            adminDurationValue.textContent = '--';
        }
    }

    function toggleAdminSections() {
        if (!adminWeeklyToggle) {
            console.error('Admin weekly toggle not found by any selector');
            return;
        }
        
        const isChecked = adminWeeklyToggle.checked;
        const outdoorSection = document.getElementById('outdoor-section');
        console.log('Admin: Toggling sections, isWeekly:', isChecked);
        
        if (isChecked) {
            if (adminDateSection) adminDateSection.style.display = 'none';
            if (adminWeeklySection) adminWeeklySection.style.display = 'block';
            if (outdoorSection) outdoorSection.style.display = 'none';
        } else {
            if (adminDateSection) adminDateSection.style.display = 'block';
            if (adminWeeklySection) adminWeeklySection.style.display = 'none';
            if (outdoorSection) outdoorSection.style.display = 'block';
        }
        calculateAdminDuration();
    }

    if (adminWeeklyToggle) {
        adminWeeklyToggle.addEventListener('change', toggleAdminSections);
        adminWeeklyToggle.addEventListener('click', toggleAdminSections);
        
        document.querySelectorAll('input[name*="start"], input[name*="end"]').forEach(el => {
            el.addEventListener('input', calculateAdminDuration);
            el.addEventListener('change', calculateAdminDuration);
        });

        toggleAdminSections();
        console.log('Admin weekly toggle initialized');
    }

    // ===== 2. Requirements Logic =====
    function initRequirementsLogic() {
        const reqToggle = document.getElementById('requirement-toggle') || 
                          document.querySelector('.requirements-toggle') || 
                          document.querySelector('input[name*="showRequirements"]');
        const reqSection = document.getElementById('requirements-selection-section');
        const requirementCards = document.querySelectorAll('.requirement-card');

        function updateVisibility() {
            if (!reqSection) return;
            const isChecked = reqToggle ? reqToggle.checked : false;
            if (isChecked) {
                reqSection.style.setProperty('display', 'block', 'important');
            } else {
                reqSection.style.setProperty('display', 'none', 'important');
            }
        }

        if (reqToggle) {
            reqToggle.addEventListener('change', updateVisibility);
            reqToggle.addEventListener('click', updateVisibility);
            updateVisibility();
        }

        requirementCards.forEach(card => {
            const checkbox = card.querySelector('.requirement-checkbox');
            if (checkbox) {
                card.addEventListener('click', function() {
                    checkbox.checked = !checkbox.checked;
                    card.classList.toggle('selected', checkbox.checked);
                    checkbox.dispatchEvent(new Event('change', { bubbles: true }));
                });
                if (checkbox.checked) card.classList.add('selected');
            }
        });

        const anyChecked = Array.from(requirementCards).some(c => c.querySelector('.requirement-checkbox')?.checked);
        if (anyChecked && reqToggle && !reqToggle.checked) {
            reqToggle.checked = true;
            updateVisibility();
        }
    }
    initRequirementsLogic();

    // ===== 3. Photo Gallery Logic =====
    const galleryItems = document.querySelectorAll('.gallery-item-admin');
    const hiddenInput = document.getElementById('event_selectedImage');
    
    if (galleryItems.length > 0 && hiddenInput) {
        const updateSelection = (selectedValue) => {
            galleryItems.forEach(item => {
                if (item.dataset.image === selectedValue) {
                    item.classList.add('selected');
                } else {
                    item.classList.remove('selected');
                }
            });
        };

        if (hiddenInput.value) {
            updateSelection(hiddenInput.value);
        }

        galleryItems.forEach(item => {
            item.addEventListener('click', function() {
                const imageName = this.dataset.image;
                hiddenInput.value = imageName;
                updateSelection(imageName);
            });
        });
    }

    // ===== 4. Weather & Maps Logic (exact same as userform) =====
    const outdoorToggle = document.getElementById('outdoor-toggle') || document.querySelector('[name*="[isOutdoor]"]');
    const weatherContainer = document.getElementById('weather-widget-container');

    // Store selected coordinates from map
    let selectedLat = null;
    let selectedLng = null;

    // WMO Weather Code descriptions in French
    const wmoDescriptions = {
        0: 'Ciel dégagé', 1: 'Principalement dégagé', 2: 'Partiellement nuageux', 3: 'Couvert',
        45: 'Brouillard', 48: 'Brouillard givrant',
        51: 'Bruine légère', 53: 'Bruine modérée', 55: 'Bruine forte',
        61: 'Pluie légère', 63: 'Pluie modérée', 65: 'Pluie forte',
        71: 'Neige légère', 73: 'Neige modérée', 75: 'Neige forte',
        80: 'Averses légères', 81: 'Averses modérées', 82: 'Averses violentes',
        95: 'Orage', 96: 'Orage avec grêle légère', 99: 'Orage avec grêle forte'
    };

    function wmoToIcon(code, isDay) {
        const prefix = isDay ? 'd' : 'n';
        if (code === 0) return '01' + prefix;
        if (code <= 2) return '02' + prefix;
        if (code === 3) return '04' + prefix;
        if (code <= 48) return '50' + prefix;
        if (code <= 55) return '09' + prefix;
        if (code <= 65) return '10' + prefix;
        if (code <= 75) return '13' + prefix;
        if (code <= 82) return '09' + prefix;
        return '11' + prefix;
    }

    function displayWeatherData(data, dateLabel) {
        if (!document.getElementById('weather-temp')) return;
        document.getElementById('weather-temp').textContent = Math.round(data.temp) + '°C';
        document.getElementById('weather-desc').textContent = data.desc;
        document.getElementById('weather-humidity').textContent = Math.round(data.humidity) + '%';
        document.getElementById('weather-wind').textContent = Math.round(data.wind) + ' km/h';
        document.getElementById('weather-icon').src = `https://openweathermap.org/img/wn/${data.icon}@2x.png`;
        
        if (dateLabel) {
            document.getElementById('weather-date').textContent = dateLabel;
        } else {
            document.getElementById('weather-date').textContent = new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
        }

        document.getElementById('weather-loading').style.display = 'none';
        document.getElementById('weather-data').style.display = 'block';
    }

    function getEventDateTime() {
        const isWeekly = adminWeeklyToggle && adminWeeklyToggle.checked;
        
        if (isWeekly) {
            const daySelect = document.querySelector('select[name*="dayOfWeek"]');
            const timeInput = document.querySelector('input[name*="startTime"]');
            
            if (daySelect && daySelect.value && timeInput && timeInput.value) {
                const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                const targetDay = days.indexOf(daySelect.value);
                
                if (targetDay !== -1) {
                    const now = new Date();
                    const resultDate = new Date();
                    // Move to the next occurrence of this day
                    let diff = (targetDay - now.getDay() + 7) % 7;
                    // If it's today but the time has passed, move to next week
                    const hour = parseInt(timeInput.value.split(':')[0], 10);
                    if (diff === 0 && hour <= now.getHours()) {
                        diff = 7;
                    }
                    resultDate.setDate(now.getDate() + diff);
                    
                    const dateStr = resultDate.toISOString().split('T')[0];
                    return { date: dateStr, hour: hour };
                }
            }
        } else {
            const startInput = document.querySelector('[name*="[startAt]"]');
            if (startInput && startInput.value) {
                const parts = startInput.value.split(' ');
                const dateStr = parts[0];
                const timeStr = parts[1] || null;
                if (dateStr && dateStr.match(/^\d{4}-\d{2}-\d{2}$/)) {
                    const hour = timeStr ? parseInt(timeStr.split(':')[0], 10) : null;
                    return { date: dateStr, hour: hour };
                }
            }
        }
        return null;
    }

    async function fetchWeatherByCoords(lat, lon) {
        if (!document.getElementById('weather-loading')) return;
        document.getElementById('weather-loading').style.display = 'block';
        document.getElementById('weather-data').style.display = 'none';
        const errorEl = document.getElementById('weather-error');
        if (errorEl) errorEl.style.display = 'none';

        try {
            const eventDT = getEventDateTime();
            let url;
            if (eventDT) {
                url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&hourly=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m,is_day&start_date=${eventDT.date}&end_date=${eventDT.date}&timezone=auto`;
            } else {
                url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m,is_day&timezone=auto`;
            }
            const response = await fetch(url);
            const data = await response.json();

            if (data.hourly && data.hourly.time && data.hourly.time.length > 0) {
                const targetHour = (eventDT && eventDT.hour !== null) ? eventDT.hour : 12;
                const h = data.hourly;
                const idx = Math.min(targetHour, h.time.length - 1);
                
                const dateObj = new Date(eventDT.date + 'T12:00:00');
                const datePart = dateObj.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
                const dateLabel = `${datePart} à ${targetHour}h`;

                displayWeatherData({
                    temp: h.temperature_2m[idx],
                    desc: wmoDescriptions[h.weather_code[idx]] || 'Inconnu',
                    humidity: h.relative_humidity_2m[idx],
                    wind: h.wind_speed_10m[idx],
                    icon: wmoToIcon(h.weather_code[idx], h.is_day[idx] === 1)
                }, dateLabel);
            } else if (data.current) {
                const c = data.current;
                displayWeatherData({
                    temp: c.temperature_2m,
                    desc: wmoDescriptions[c.weather_code] || 'Inconnu',
                    humidity: c.relative_humidity_2m,
                    wind: c.wind_speed_10m,
                    icon: wmoToIcon(c.weather_code, c.is_day === 1)
                });
            } else {
                throw new Error('Données météo indisponibles');
            }
        } catch (error) {
            document.getElementById('weather-loading').style.display = 'none';
            if (errorEl) {
                errorEl.style.display = 'block';
                const errorMsg = document.getElementById('weather-error-msg');
                if (errorMsg) errorMsg.textContent = error.message;
            }
        }
    }

    async function fetchWeatherForLocation() {
        // Priority 1: Use coordinates from the map marker
        if (selectedLat && selectedLng) {
            fetchWeatherByCoords(selectedLat, selectedLng);
            return;
        }

        // Priority 2: Geocode the text in the location input
        if (locationInput && locationInput.value && locationInput.value.trim()) {
            try {
                const geoUrl = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationInput.value)}&limit=1`;
                const geoResponse = await fetch(geoUrl);
                const geoData = await geoResponse.json();
                if (geoData.length > 0) {
                    fetchWeatherByCoords(parseFloat(geoData[0].lat), parseFloat(geoData[0].lon));
                    return;
                }
            } catch (err) {
                console.error('Geocoding for weather failed:', err);
            }
        }

        // Priority 3: Default to Tunis
        fetchWeatherByCoords(36.8065, 10.1815);
    }

    function toggleWeatherWidget() {
        if (!weatherContainer) return;
        if (outdoorToggle && outdoorToggle.checked) {
            weatherContainer.style.display = 'block';
            fetchWeatherForLocation();
        } else {
            weatherContainer.style.display = 'none';
        }
    }

    if (outdoorToggle) {
        outdoorToggle.addEventListener('change', toggleWeatherWidget);
        toggleWeatherWidget();
    }

    // Update weather when location or time/date changes
    if (locationInput) {
        locationInput.addEventListener('change', () => {
            if (outdoorToggle && outdoorToggle.checked) fetchWeatherForLocation();
        });
    }

    // Refresh weather when date or time changes
    document.querySelectorAll('input[name*="startAt"], select[name*="dayOfWeek"], input[name*="startTime"]').forEach(el => {
        el.addEventListener('change', () => {
            if (outdoorToggle && outdoorToggle.checked) fetchWeatherForLocation();
        });
    });

    // ===== 5. Leaflet Map Picker Logic (exact same as userform) =====
    const toggleMapBtn = document.getElementById('toggle-map-picker');
    const closeMapBtn = document.getElementById('close-map-picker');
    const mapPickerContainer = document.getElementById('map-picker-container');
    const mapDiv = document.getElementById('location-map');
    
    console.log('MAP DEBUG: toggleMapBtn =', toggleMapBtn);
    console.log('MAP DEBUG: closeMapBtn =', closeMapBtn);
    console.log('MAP DEBUG: mapPickerContainer =', mapPickerContainer);
    console.log('MAP DEBUG: mapDiv =', mapDiv);

    let leafletMap, leafletMarker;

    function initLeafletMap() {
        console.log('MAP DEBUG: initLeafletMap called, leafletMap =', leafletMap);
        if (leafletMap) return;

        // Fix default marker icon (broken when Leaflet loaded via CDN)
        delete L.Icon.Default.prototype._getIconUrl;
        L.Icon.Default.mergeOptions({
            iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
            iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
            shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
        });

        const initialPos = [36.8065, 10.1815]; // Tunis
        
        leafletMap = L.map('location-map').setView(initialPos, 13);
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>'
        }).addTo(leafletMap);

        leafletMarker = L.marker(initialPos, {
            draggable: true
        }).addTo(leafletMap);

        // Click on map to move marker
        leafletMap.on('click', (e) => {
            updatePosition(e.latlng.lat, e.latlng.lng);
        });

        // Drag end handler
        leafletMarker.on('dragend', () => {
            const pos = leafletMarker.getLatLng();
            updatePosition(pos.lat, pos.lng);
        });
        
        console.log('MAP DEBUG: Leaflet map initialized successfully');
    }

    function updatePosition(lat, lng) {
        leafletMarker.setLatLng([lat, lng]);
        leafletMap.panTo([lat, lng]);

        // Store coordinates for weather
        selectedLat = lat;
        selectedLng = lng;
        
        // Use Nominatim for reverse geocoding
        fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
            .then(response => response.json())
            .then(data => {
                if (data.display_name) {
                    locationInput.value = data.display_name;
                    locationInput.dispatchEvent(new Event('change'));
                }
            })
            .catch(err => console.error('Geocoding error:', err));

        // Auto-update weather when location changes on map
        if (outdoorToggle && outdoorToggle.checked) {
            fetchWeatherByCoords(lat, lng);
        }
    }

    function loadLeafletScript() {
        console.log('MAP DEBUG: loadLeafletScript called, window.L =', !!window.L);
        if (window.L) {
            initLeafletMap();
            setTimeout(() => leafletMap.invalidateSize(), 100);
            return;
        }

        // Add Leaflet CSS
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://unpkg.com/leaflet/dist/leaflet.css';
        document.head.appendChild(link);

        // Add Leaflet JS
        const script = document.createElement('script');
        script.src = 'https://unpkg.com/leaflet/dist/leaflet.js';
        script.onload = () => {
            console.log('MAP DEBUG: Leaflet script loaded, L =', !!window.L);
            initLeafletMap();
            setTimeout(() => leafletMap.invalidateSize(), 200);
        };
        script.onerror = (err) => {
            console.error('MAP DEBUG: Failed to load Leaflet script!', err);
        };
        document.head.appendChild(script);
    }

    if (toggleMapBtn) {
        console.log('MAP DEBUG: Attaching click listener to toggleMapBtn');
        toggleMapBtn.addEventListener('click', function () {
            console.log('MAP DEBUG: Carte button CLICKED!');
            if (!mapPickerContainer) {
                console.error('MAP DEBUG: mapPickerContainer is null!');
                return;
            }

            mapPickerContainer.style.display = 'block';
            console.log('MAP DEBUG: container shown, loading leaflet...');

            loadLeafletScript();

            // Critical for Leaflet rendering
            setTimeout(() => {
                if (leafletMap) {
                    leafletMap.invalidateSize();
                    console.log('MAP DEBUG: invalidateSize called');
                }
            }, 300);
        });
    } else {
        console.error('MAP DEBUG: toggleMapBtn NOT FOUND! Button with id="toggle-map-picker" missing from DOM.');
    }

    if (closeMapBtn) {
        closeMapBtn.addEventListener('click', function () {
            if (!mapPickerContainer) return;
            mapPickerContainer.style.display = 'none';
        });
    }

    console.log('Admin Form: Script fully initialized');
    calculateAdminDuration();
});
</script>

