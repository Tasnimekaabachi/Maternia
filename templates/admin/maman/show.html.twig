{% extends 'admin/base.html.twig' %}

{% block title %}Profil maman #{{ maman.id }}{% endblock %}
{% block page_title %}Profil maman #{{ maman.id }}{% endblock %}

{% block breadcrumb %}
    <div class="admin-breadcrumb">
        <a href="{{ path('admin_dashboard') }}">Backoffice</a>
        <span>/</span>
        <a href="{{ path('admin_suivi_grossesse') }}">Suivi grossesse</a>
        <span>/</span>
        <span>Profil #{{ maman.id }}</span>
    </div>
{% endblock %}

{% block header_actions %}{% endblock %}

{% block content %}
<style>
.info-card {
    background: white;
    border-radius: 16px;
    border: 1.5px solid #f0f0f0;
    margin-bottom: 20px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
}
.info-card-header {
    padding: 14px 20px;
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1.5px solid #f5f5f5;
}
.info-card-header .header-icon {
    width: 34px; height: 34px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
}
.info-card-body { padding: 20px; }
.field-row {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 14px;
    border-radius: 10px;
    background: #fafafa;
    border: 1px solid #f0f0f0;
}
.field-label {
    font-size: 11px;
    font-weight: 700;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.field-value {
    font-size: 14px;
    font-weight: 600;
    color: #333;
}
.risk-card {
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
}
</style>

    {# Banner profil #}
    <div style="background:linear-gradient(135deg,#e91e8c,#ff6bb3);border-radius:16px;padding:24px;margin-bottom:24px;display:flex;align-items:center;gap:20px;box-shadow:0 4px 20px rgba(233,30,140,0.3);">
        <div style="width:64px;height:64px;background:rgba(255,255,255,0.25);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:30px;flex-shrink:0;">🤱</div>
        <div>
            <div style="color:white;font-size:22px;font-weight:800;">Maman #{{ maman.id }}</div>
            <div style="color:rgba(255,255,255,0.85);font-size:13px;margin-top:4px;">
                📞 +216 {{ maman.numeroUrgence }}
                &nbsp;•&nbsp;
                🩸 {{ maman.groupeSanguin }}
                &nbsp;•&nbsp;
                📅 Enregistrée le {{ maman.dateCreation ? maman.dateCreation|date('d/m/Y') : '—' }}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">

            {# Contact & santé #}
            <div class="info-card">
                <div class="info-card-header">
                    <div class="header-icon" style="background:rgba(233,30,140,0.1);">📞</div>
                    <span style="color:#333;">Contact & santé</span>
                </div>
                <div class="info-card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="field-row">
                                <span class="field-label">Numéro d'urgence</span>
                                <span class="field-value">+216 {{ maman.numeroUrgence }}</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="field-row">
                                <span class="field-label">Groupe sanguin</span>
                                <span class="field-value">🩸 {{ maman.groupeSanguin }}</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="field-row">
                                <span class="field-label">Taille</span>
                                <span class="field-value">📏 {{ maman.taille }} cm</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="field-row">
                                <span class="field-label">Poids</span>
                                <span class="field-value">⚖️ {{ maman.poids ?? '—' }} kg</span>
                            </div>
                        </div>
                        {% if maman.imc %}
                        <div class="col-sm-12">
                            <div class="field-row" style="background:{% if maman.imcAlerte %}rgba(244,67,54,0.05);border-color:rgba(244,67,54,0.2){% else %}rgba(76,175,80,0.05);border-color:rgba(76,175,80,0.2){% endif %};">
                                <span class="field-label">IMC</span>
                                <span class="field-value">
                                    {{ maman.imc }} — {{ maman.imcCategorie }}
                                    {% if maman.imcAlerte %}
                                        <span style="background:#f44336;color:white;border-radius:6px;padding:2px 8px;font-size:11px;margin-left:8px;">⚠️ Alerte</span>
                                    {% else %}
                                        <span style="background:#4caf50;color:white;border-radius:6px;padding:2px 8px;font-size:11px;margin-left:8px;">✅ Normal</span>
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Antécédents #}
            <div class="info-card">
                <div class="info-card-header">
                    <div class="header-icon" style="background:rgba(156,39,176,0.1);">📋</div>
                    <span style="color:#333;">Antécédents & traitements</span>
                </div>
                <div class="info-card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="field-row">
                                <span class="field-label">🌿 Allergies</span>
                                <span class="field-value">{{ maman.allergies ?? '—' }}</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-row">
                                <span class="field-label">🏥 Antécédents médicaux</span>
                                <span class="field-value">{{ maman.antecedentsMedicaux ?? '—' }}</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-row">
                                <span class="field-label">💊 Maladies chroniques</span>
                                <span class="field-value">{{ maman.maladiesChroniques ?? '—' }}</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-row">
                                <span class="field-label">💉 Médicaments actuels</span>
                                <span class="field-value">{{ maman.medicamentsActuels ?? '—' }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Mode de vie #}
            <div class="info-card">
                <div class="info-card-header">
                    <div class="header-icon" style="background:rgba(76,175,80,0.1);">🌿</div>
                    <span style="color:#333;">Mode de vie</span>
                </div>
                <div class="info-card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="field-row" style="{{ maman.fumeur ? 'background:rgba(244,67,54,0.05);border-color:rgba(244,67,54,0.2);' : '' }}">
                                <span class="field-label">Fumeuse</span>
                                <span class="field-value">
                                    {% if maman.fumeur %}
                                        <span style="color:#f44336;">🚬 Oui</span>
                                    {% else %}
                                        <span style="color:#4caf50;">✅ Non</span>
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="field-row" style="{{ maman.consommationAlcool ? 'background:rgba(244,67,54,0.05);border-color:rgba(244,67,54,0.2);' : '' }}">
                                <span class="field-label">Consommation alcool</span>
                                <span class="field-value">
                                    {% if maman.consommationAlcool %}
                                        <span style="color:#f44336;">🍷 Oui</span>
                                    {% else %}
                                        <span style="color:#4caf50;">✅ Non</span>
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-row">
                                <span class="field-label">🏃 Niveau d'activité physique</span>
                                <span class="field-value">{{ maman.niveauActivitePhysique }}</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-row">
                                <span class="field-label">🥗 Habitudes alimentaires</span>
                                <span class="field-value">{{ maman.habitudesAlimentaires ?? '—' }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">

            {# Badge Risque IA #}
            {% if grossesse and grossesse.riskLevel is not null %}
            <div class="risk-card">
                {% if grossesse.riskLevel == 'High' %}
                    <div style="background:linear-gradient(135deg,#f44336,#ef9a9a);padding:20px;text-align:center;">
                        <div style="font-size:2.5rem;">🚨</div>
                        <div style="color:white;font-weight:800;font-size:18px;margin-top:8px;">Risque Élevé</div>
                        <div style="color:rgba(255,255,255,0.85);font-size:12px;margin-top:4px;">Analyse IA — Modèle KNN</div>
                    </div>
                    <div style="background:white;padding:16px;text-align:center;">
                        <p style="color:#c62828;font-size:13px;margin:0;">⚠️ Suivi médical rapproché recommandé.</p>
                    </div>
                {% elseif grossesse.riskLevel == 'Mid' %}
                    <div style="background:linear-gradient(135deg,#ff9800,#ffcc80);padding:20px;text-align:center;">
                        <div style="font-size:2.5rem;">⚠️</div>
                        <div style="color:white;font-weight:800;font-size:18px;margin-top:8px;">Risque Modéré</div>
                        <div style="color:rgba(255,255,255,0.85);font-size:12px;margin-top:4px;">Analyse IA — Modèle KNN</div>
                    </div>
                    <div style="background:white;padding:16px;text-align:center;">
                        <p style="color:#e65100;font-size:13px;margin:0;">Surveillance régulière conseillée.</p>
                    </div>
                {% else %}
                    <div style="background:linear-gradient(135deg,#4caf50,#a5d6a7);padding:20px;text-align:center;">
                        <div style="font-size:2.5rem;">✅</div>
                        <div style="color:white;font-weight:800;font-size:18px;margin-top:8px;">Risque Faible</div>
                        <div style="color:rgba(255,255,255,0.85);font-size:12px;margin-top:4px;">Analyse IA — Modèle KNN</div>
                    </div>
                    <div style="background:white;padding:16px;text-align:center;">
                        <p style="color:#2e7d32;font-size:13px;margin:0;">✅ Aucun facteur de risque détecté.</p>
                    </div>
                {% endif %}
            </div>
            {% endif %}

            {# Informations système #}
            <div class="info-card">
                <div class="info-card-header">
                    <div class="header-icon" style="background:rgba(74,144,217,0.1);">⚙️</div>
                    <span style="color:#333;">Informations système</span>
                </div>
                <div class="info-card-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <div class="field-row">
                                <span class="field-label">ID</span>
                                <span class="field-value">#{{ maman.id }}</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-row">
                                <span class="field-label">Date création</span>
                                <span class="field-value">{{ maman.dateCreation ? maman.dateCreation|date('d/m/Y H:i') : '—' }}</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="field-row">
                                <span class="field-label">Dernière mise à jour</span>
                                <span class="field-value">{{ maman.dateMiseAJour ? maman.dateMiseAJour|date('d/m/Y H:i') : '—' }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <a href="{{ path('admin_suivi_grossesse') }}" class="btn btn-outline-rose btn-sm"><i class="fas fa-arrow-left me-1"></i> Retour</a>
                        <a href="{{ path('admin_maman_pdf', { id: maman.id }) }}" class="btn admin-btn-rose btn-sm" target="_blank"><i class="fas fa-file-pdf me-1"></i> PDF</a>
                        <a href="{{ path('admin_maman_edit', { id: maman.id }) }}" class="btn admin-btn-rose btn-sm"><i class="fas fa-edit me-1"></i> Modifier</a>
                        {{ include('admin/maman/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>

        </div>
    </div>
{% endblock %}