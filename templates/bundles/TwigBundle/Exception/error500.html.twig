{% extends 'base.html.twig' %}

{% block title %}Erreur serveur - Maternia{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .error-page-wrapper {
            background: linear-gradient(-45deg, #e0c3fc, #fbc2eb, #a1c4fd, #c2e9fb);
            background-size: 400% 400%;
            animation: flowingGradient 15s ease infinite;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        @keyframes flowingGradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .error-card {
            background: #ffffff;
            border-radius: 40px;
            border: none;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.1);
            padding: 60px 40px;
            width: 100%;
            max-width: 500px;
            text-align: center;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .error-card:hover {
            transform: translateY(-10px);
        }

        .error-code {
            font-size: 120px;
            font-weight: 800;
            background: linear-gradient(90deg, #ff6b8b 0%, #f06292 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1;
            margin-bottom: 20px;
            text-shadow: 0 10px 20px rgba(255, 107, 139, 0.2);
        }

        .error-title {
            color: #4a5568;
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .error-title span {
            color: #d53f8c;
        }

        .error-message {
            color: #718096;
            font-size: 1.1rem;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .error-icon {
            font-size: 80px;
            margin-bottom: 20px;
            color: #ff6b8b;
            opacity: 0.8;
        }

        .btn-error {
            background: linear-gradient(90deg, #ff6b8b 0%, #f06292 100%);
            border: none;
            border-radius: 20px;
            color: white;
            font-weight: 700;
            padding: 15px 40px;
            text-transform: uppercase;
            box-shadow: 0 10px 20px rgba(255, 107, 139, 0.3);
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin: 10px;
        }

        .btn-error:hover {
            transform: scale(1.05);
            filter: brightness(1.1);
            color: white;
        }

        .contact-support {
            margin-top: 30px;
            padding-top: 30px;
            border-top: 2px solid #f0f0f0;
            color: #718096;
        }
    </style>
{% endblock %}

{% block body %}
<div class="error-page-wrapper">
    <div class="error-card">
        <div class="error-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        
        <div class="error-code">500</div>
        
        <h1 class="error-title">
            Erreur <span>serveur</span>
        </h1>
        
        <div class="error-message">
            <p>Désolé, une erreur technique est survenue.</p>
            <p>Notre équipe a été notifiée et travaille sur la résolution du problème.</p>
        </div>

        <div class="mt-4">
            <a href="{{ path('app_user_profile') }}" class="btn-error">
                <i class="fas fa-home me-2"></i>Accueil
            </a>
        </div>

        <div class="contact-support">
            <p class="small">
                Si le problème persiste, contactez-nous à 
                <a href="mailto:support@maternia.tn" class="text-primary">support@maternia.tn</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}