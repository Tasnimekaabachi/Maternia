{% extends 'base.html.twig' %}

{% block title %}Page non trouvée - Maternia{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .error-page-wrapper {
            background: linear-gradient(-45deg, #e0c3fc, #fbc2eb, #a1c4fd, #c2e9fb);
            background-size: 400% 400%;
            animation: flowingGradient 15s ease infinite;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        @keyframes flowingGradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .error-card {
            background: #ffffff;
            border-radius: 40px;
            border: none;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.1);
            padding: 60px 40px;
            width: 100%;
            max-width: 500px;
            text-align: center;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .error-card:hover {
            transform: translateY(-10px);
        }

        .error-code {
            font-size: 120px;
            font-weight: 800;
            background: linear-gradient(90deg, #ff6b8b 0%, #f06292 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1;
            margin-bottom: 20px;
            text-shadow: 0 10px 20px rgba(255, 107, 139, 0.2);
        }

        .error-title {
            color: #4a5568;
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .error-title span {
            color: #d53f8c;
        }

        .error-message {
            color: #718096;
            font-size: 1.1rem;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .error-icon {
            font-size: 80px;
            margin-bottom: 20px;
            color: #ff6b8b;
            opacity: 0.8;
        }

        .btn-error {
            background: linear-gradient(90deg, #ff6b8b 0%, #f06292 100%);
            border: none;
            border-radius: 20px;
            color: white;
            font-weight: 700;
            padding: 15px 40px;
            text-transform: uppercase;
            box-shadow: 0 10px 20px rgba(255, 107, 139, 0.3);
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin: 10px;
        }

        .btn-error:hover {
            transform: scale(1.05);
            filter: brightness(1.1);
            color: white;
        }

        .btn-outline-error {
            background: transparent;
            border: 2px solid #ff6b8b;
            border-radius: 20px;
            color: #ff6b8b;
            font-weight: 600;
            padding: 15px 40px;
            text-transform: uppercase;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin: 10px;
        }

        .btn-outline-error:hover {
            background: #ff6b8b;
            color: white;
            transform: scale(1.02);
        }

        .search-bar {
            margin-top: 30px;
            padding-top: 30px;
            border-top: 2px solid #f0f0f0;
        }

        .search-input {
            background-color: #f7fafc;
            border: 2px solid transparent;
            border-radius: 15px;
            padding: 15px 20px;
            color: #2d3748;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
        }

        .search-input:hover, .search-input:focus {
            transform: scale(1.03);
            background-color: #ffffff;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
            border-color: #f06292;
            outline: none;
        }
    </style>
{% endblock %}

{% block body %}
<div class="error-page-wrapper">
    <div class="error-card">
        <div class="error-icon">
            <i class="fas fa-shield-alt"></i>
        </div>
        
        <div class="error-code">404</div>
        
        <h1 class="error-title">
            Page non <span>trouvée</span>
        </h1>
        
        <div class="error-message">
            <p>Désolé, la page que vous recherchez n'existe pas ou vous n'avez pas les permissions nécessaires pour y accéder.</p>
            <p class="mt-3 small text-muted">Si vous pensez qu'il s'agit d'une erreur, contactez l'équipe Maternia.</p>
        </div>

        <div class="mt-4">
            <a href="{{ path('app_user_profile') }}" class="btn-error">
                <i class="fas fa-home me-2"></i>Accueil
            </a>
            <a href="javascript:history.back()" class="btn-outline-error">
                <i class="fas fa-arrow-left me-2"></i>Retour
            </a>
        </div>

        <div class="search-bar">
            <form action="{{ path('app_user_profile') }}" method="get">
                <div class="position-relative">
                    <input type="text" class="search-input" placeholder="Rechercher sur Maternia..." name="q">
                    <button type="submit" class="position-absolute top-50 end-0 translate-middle-y btn btn-link text-primary" style="right: 15px !important;">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}